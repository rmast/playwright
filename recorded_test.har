            "size": -1,
            "mimeType": "text/javascript",
            "text": "// JavaScript Document\r\n//jquery\r\njQuery(document).ready(function() {\r\n\t// hoveren van \"default button\" button in ie6\r\n\tjQuery('.nav li').mouseover(function() {\r\n\t\tjQuery(this).addClass('ie_does_hover');\t\t\t\t\t\t\t\t\t\t\r\n\t});\r\n\tjQuery('.nav li').mouseout(function() {\r\n\t\tjQuery(this).removeClass('ie_does_hover');\t\t\t\t\t\t\t\t\t\t\r\n\t});\r\n\t\t\t\t\t\t   \r\n\t// hoveren van \"default button\" button in ie6\r\n\tjQuery('.ie6hover.button').mouseenter(function() {\r\n\t\tjQuery(this).addClass('hoverbutton');\t\t\t\t\t\t\t\t\t\t\r\n\t});\r\n\tjQuery('.ie6hover.button').mouseleave(function() {\r\n\t\tjQuery(this).removeClass('hoverbutton');\t\t\t\t\t\t\t\t\t\t\r\n\t});\r\n\r\n\t// hoveren van \"volgende\" button in ie6\r\n\tjQuery('.ie6hover.volgende').mouseenter(function() {\r\n\t\tjQuery(this).addClass('hovervolgendebutton');\t\t\t\t\t\t\t\t\t\t\r\n\t});\r\n\tjQuery('.ie6hover.volgende').mouseleave(function() {\r\n\t\tjQuery(this).removeClass('hovervolgendebutton');\t\t\t\t\t\t\t\t\t\t\r\n\t});\r\n\t// hoveren van \"vorige\" buttons in ie6\r\n\tjQuery('.ie6hover.vorige').mouseenter(function() {\r\n\t\tjQuery(this).addClass('hovervorigebutton');\t\t\t\t\t\t\t\t\t\t\r\n\t});\r\n\tjQuery('.ie6hover.vorige').mouseleave(function() {\r\n\t\tjQuery(this).removeClass('hovervorigebutton');\t\t\t\t\t\t\t\t\t\t\r\n\t});\r\n\t// hoveren van \"opslaan\" buttons in ie6\r\n\tjQuery('.ie6hover.opslaan').mouseenter(function() {\r\n\t\tjQuery(this).addClass('hoveropslaanbutton');\t\t\t\t\t\t\t\t\t\t\r\n\t});\r\n\tjQuery('.ie6hover.opslaan').mouseleave(function() {\r\n\t\tjQuery(this).removeClass('hoveropslaanbutton');\t\t\t\t\t\t\t\t\t\t\r\n\t});\r\n\t// hoveren van \"verwijder\" buttons in ie6\r\n\tjQuery('.ie6hover.verwijder').mouseenter(function() {\r\n\t\tjQuery(this).addClass('hoververwijderbutton');\t\t\t\t\t\t\t\t\t\t\r\n\t});\r\n\tjQuery('.ie6hover.verwijder').mouseleave(function() {\r\n\t\tjQuery(this).removeClass('hoververwijderbutton');\t\t\t\t\t\t\t\t\t\t\r\n\t});\r\n\t// hoveren van \"blokkeer\" buttons in ie6\r\n\tjQuery('.ie6hover.blokkeer').mouseenter(function() {\r\n\t\tjQuery(this).addClass('hoverblokkeerbutton');\t\t\t\t\t\t\t\t\t\t\r\n\t});\r\n\tjQuery('.ie6hover.blokkeer').mouseleave(function() {\r\n\t\tjQuery(this).removeClass('hoverblokkeerbutton');\t\t\t\t\t\t\t\t\t\t\r\n\t});\r\n\t// hoveren van \"deblokkeer\" buttons in ie6\r\n\tjQuery('.ie6hover.deblokkeer').mouseenter(function() {\r\n\t\tjQuery(this).addClass('hoverdeblokkeerbutton');\t\t\t\t\t\t\t\t\t\t\r\n\t});\r\n\tjQuery('.ie6hover.deblokkeer').mouseleave(function() {\r\n\t\tjQuery(this).removeClass('hoverdeblokkeerbutton');\t\t\t\t\t\t\t\t\t\t\r\n\t});\r\n\t// hoveren van \"blokkeer\" buttons in ie6\r\n\tjQuery('.ie6hover.zoekbutton').mouseenter(function() {\r\n\t\tjQuery(this).addClass('hoverzoekbutton');\t\t\t\t\t\t\t\t\t\t\r\n\t});\r\n\tjQuery('.ie6hover.zoekbutton').mouseleave(function() {\r\n\t\tjQuery(this).removeClass('hoverzoekbutton');\t\t\t\t\t\t\t\t\t\t\r\n\t});\r\n\r\n\t//hover table row\r\n\tjQuery('table.hovertable tbody tr').live('mouseover', function() {\r\n\t\tjQuery(this).addClass('hovertablerow');\r\n\t});\r\n\tjQuery('table.hovertable tbody tr').live('mouseout', function() {\r\n\t\tjQuery(this).removeClass('hovertablerow');\t\t\t\t\t\t\t\t\t\t\r\n\t});\r\n\t\r\n\t//hover table row speciaal voor beoordelingspunten parent regels(added 10-11-2010 by Inge)\r\n\tjQuery('table.hovertable.waarde tbody tr.parent').mouseenter(function() {\r\n\t\tjQuery(this).addClass('hoverparentrow');\r\n\t});\r\n\tjQuery('table.hovertable.waarde tbody tr.parent').mouseleave(function() {\r\n\t\tjQuery(this).removeClass('hoverparentrow');\t\t\t\t\t\t\t\t\t\t\r\n\t});\r\n\t//hover table row speciaal voor beoordelingspunten child regels (added 10-11-2010 by Inge)\r\n\tjQuery('table.hovertable.waarde tbody tr.child').mouseenter(function() {\r\n\t\tjQuery(this).addClass('hoverchildrow');\r\n\t});\r\n\tjQuery('table.hovertable.waarde tbody tr.child').mouseleave(function() {\r\n\t\tjQuery(this).removeClass('hoverchildrow');\t\t\t\t\t\t\t\t\t\t\r\n\t});\r\n});"
