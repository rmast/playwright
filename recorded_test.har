          "content": {
            "size": -1,
            "mimeType": "text/javascript",
            "text": "// ------------------------------------------------------------\r\n//\r\n// function selectLovRow(event,lovName)\r\n//\r\n// method called when row in List Of Values is clicked. \r\n// The id of the entity in the selected row is passed to\r\n// a call which can be captured by an Ajax jsFuntion object\r\n// in the page.\r\n//\r\n// ------------------------------------------------------------\r\nfunction selectLovRow(event,lovName) {\r\n\tvar row;\r\n\tvar rowPrefix = lovName + '|';\r\n\tvar len = rowPrefix.length;\r\n\t\r\n\trow = getSelectedLovRow(event);\r\n\tif (row && row.id && row.id.indexOf(rowPrefix) == 0) {\r\n\t\tvar selectedId = row.id.substring(rowPrefix.length);\r\n\t\tvar dialogId = jQuery('#' + lovName + '\\\\|' + selectedId).closest('div.rich-mpnl-content').attr('id');\r\n\t\tdialogId = dialogId.substring(0, dialogId.lastIndexOf('ContentDiv'));\r\n\t\tRichfaces.hideModalPanel(dialogId);\r\n\t\tremoteSelectLovId(selectedId);\r\n\t}\r\n}\r\n\r\nfunction getSelectedLovRow(event) {\r\n\tvar row;\r\n\tif (event.target) {\r\n\t\trow = event.target.parentNode;\r\n\t} else {\r\n\t\trow = event.srcElement.parentElement;\r\n\t}\r\n\tif (row && row.id) {\r\n\t\treturn row;\r\n\t}\r\n\treturn null;\r\n}\r\n\r\nfunction getSelectedId(row) {\r\n\tvar re = new RegExp(\"\\\\|(\\\\d+)$\");\r\n\tvar m = re.exec(row.id);\r\n\tif (m != null) {\r\n\t\treturn m[1];\r\n\t}\r\n\treturn null;\r\n}\r\n\r\nfunction getLovDialogId(row) {\r\n\tvar selector = '#' + row.id.replace(/([\\.:\\|])/, '\\\\$1');\r\n\tvar dialogId = jQuery(selector).closest('div.rich-mpnl-content').attr('id');\r\n\tdialogId = dialogId.substring(0, dialogId.lastIndexOf('ContentDiv'));\r\n\treturn dialogId;\r\n}\r\n\r\n// Callback function has 1 parameter:\r\n// the selected row id.\r\nfunction selectLovRow2(event, callback) {\r\n\t\r\n\tvar row = getSelectedLovRow(event);\r\n\tif (row) {\r\n\t\tvar selectedId = getSelectedId(row);\r\n\t\tif (selectedId) {\r\n\t\t\tvar dialogId = getLovDialogId(row);\r\n\t\t\tRichfaces.hideModalPanel(dialogId);\r\n\t\t\tcallback(selectedId);\r\n\t\t}\r\n\t}\r\n}\r\n\r\n// Callback function has 2 parameters:\r\n// the dialogId and the selected row id.\r\nfunction selectLovRow3(event, callback) {\r\n\t\r\n\tvar row = getSelectedLovRow(event);\r\n\tif (row) {\r\n\t\tvar selectedId = getSelectedId(row);\r\n\t\tif (selectedId) {\r\n\t\t\tvar dialogId = getLovDialogId(row);\r\n\t\t\tRichfaces.hideModalPanel(dialogId);\r\n\t\t\tcallback(dialogId,selectedId);\r\n\t\t}\r\n\t}\r\n}\r\n"
          },
