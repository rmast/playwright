            "text": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\" >\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n\n<head>\n<link rel=\"stylesheet\" href=\"/cbbs/faces/myFacesExtensionResource/org.apache.myfaces.renderkit.html.util.MyFacesResourceLoader/17809064/calendar.HtmlCalendarRenderer/WH/theme.css\" type=\"text/css\" />\n<link rel=\"stylesheet\" href=\"/cbbs/faces/myFacesExtensionResource/org.apache.myfaces.renderkit.html.util.MyFacesResourceLoader/17809064/calendar.HtmlCalendarRenderer/DB/theme.css\" type=\"text/css\" />\n<script type=\"text/javascript\" src=\"/cbbs/resources/scripts/prototype.js\"><!--\n\n//--></script>\n<script type=\"text/javascript\" src=\"/cbbs/resources/scripts/date.js\"><!--\n\n//--></script>\n<script type=\"text/javascript\" src=\"/cbbs/resources/scripts/popcalendar.js\"><!--\n\n//--></script>\n<script type=\"text/javascript\" src=\"/cbbs/faces/myFacesExtensionResource/org.apache.myfaces.renderkit.html.util.MyFacesResourceLoader/17809064/inputTextHelp.HtmlTextHelpRenderer/inputTextHelp.js\"><!--\n\n//--></script>\n\t<title>Claim Beoordelings- en Borgings Systeem (CBBS)</title>\n\t<link class=\"component\" href=\"/cbbs/a4j/s/3_3_3.Finalorg/richfaces/renderkit/html/css/basic_classes.xcss/DATB/eAE7ff3HutDlM6QBGgsE-A__.jsf\" rel=\"stylesheet\" type=\"text/css\" /><link class=\"component\" href=\"/cbbs/a4j/s/3_3_3.Finalorg/richfaces/renderkit/html/css/extended_classes.xcss/DATB/eAE7ff3HutDlM6QBGgsE-A__.jsf\" media=\"rich-extended-skinning\" rel=\"stylesheet\" type=\"text/css\" /><script src=\"/cbbs/a4j/g/3_3_3.Finalorg.ajax4jsf.javascript.AjaxScript.jsf\" type=\"text/javascript\"></script><script src=\"/cbbs/a4j/g/3_3_3.Finalorg/ajax4jsf/javascript/scripts/form.js.jsf\" type=\"text/javascript\"></script><script type=\"text/javascript\">window.RICH_FACES_EXTENDED_SKINNING_ON=true;</script><script src=\"/cbbs/a4j/g/3