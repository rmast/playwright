          "content": {
            "size": -1,
            "mimeType": "text/javascript",
            "text": "// This function is used by the countingTextarea component. \r\n// It counts and limits the users input to maxLength characters.\r\n//\r\nfunction countITA(source, counterId, maxLength) {\r\n\t\r\n\t// Determine number of remaining characters\r\n\tvar restSize = maxLength - source.value.length; \r\n\tvar enterCount = 0;\r\n\t// Browser only has \\n, and counts this as one char. \r\n\t// Server side we get \\n\\r so as two characters, subtract them from the total.\r\n\tif (source.value.match(/\\n/g) != null) {\r\n\t\tenterCount = source.value.match(/\\n/g).length;\r\n\t}\r\n\trestSize = restSize - enterCount;\r\n\t// Truncate text if length exceeds maxLength\r\n\tif (restSize < 0) {\r\n\t\tsource.value = source.value.substring(0, maxLength - enterCount);\r\n\t\trestSize = 0;\r\n\t}\r\n\t// Get counter element from document and \r\n\t// set value of label to length of text in source\r\n\tcounterElem = document.getElementById(counterId);\r\n\tcounterElem.firstChild.data = restSize;\r\n}\r\n"
          },
