            "mimeType": "text/css",
            "text": "@charset \"utf-8\";\r\n/* CSS Document */\r\n\r\n/* RICHFACES RESTYLING */\r\n\r\n/* ----------------------------------------------------------------------------------------------- */\r\n.dr-table { width:100%; border-top:0px; border-left:0px; empty-cells:show; border-collapse:collapse; z-index:2; margin:5px 0px 0px 0px;}\r\n.dr-table-cell { border-right:0px; border-bottom:0px; padding:3px 5px 3px 5px; }\r\n.dr-subtable-cell { border-right:0px; border-bottom:0px; padding:4px 4px 4px 4px; }\r\n.dr-table-header { background-color:#fff; padding:1px; background-image:none; background-position:top left; background-repeat:repeat-x; }\r\n.dr-table-headercell { border-right:0px; border-bottom:0px; padding:0px; text-align:center; font-weight:bold; color:#036; background:none;}\r\n.dr-table-thead { border-bottom:0px; }\r\n.dr-table-subheadercell { margin:0px; border-right:0px; padding:4px 5px 3px 5px; text-align:center; font-weight:bold; color:#fff; background:#001b4d url(../images/verloop-blauw.gif) left bottom repeat-x; white-space:nowrap; text-align:left;}\r\n.dr-table-sortable-header { background-position:right center; background-repeat:no-repeat; white-space:nowrap; }\r\n/*extra*/span.dr-table-sortable-header {margin:0px; padding:0px; text-decoration:underline;}\r\nspan.dr-table-sortable-header span {}\r\n.dr-table-cursor-pointer { cursor:pointer; }\r\n.rich-inplace-edit, .rich-inplace-view { cursor:default; }\r\n.dr-table-header-sort-img { vertical-align:middle; }\r\n/*extra*/.dr-table-footer { background-color:#fff; padding:1px;}\r\n.dr-table-footercell { border-right:0px; border-bottom:0px; padding:0px; text-align:left; font-weight:bold; }\r\n.dr-table-subfootercell { border-right:0px; border-bottom:0px; padding:4px 4px 4px 4px; text-align:left; }\r\n.dr-subtable-headercell { border-right:0px; border-bottom:0px; padding:4px 4px 4px 4px; text-align:center; }\r\n.dr-subtable-footercell { border-right:0px; border-bottom:0px; padding:4px 4px 4px 4px; text-align:left; }\r\n.rich-sort-asc { background-image:url(../images/sort_az_wit.gif); }\r\n.rich-sort-desc { background-image:url(../images/sort_za_wit.gif); }\r\n.dr-table th span {float:left; clear:both;}\r\n.dr-table td span {display:block; clear:both;}\r\n.dr-table td a span {display:none;}\r\n/* hover */\r\n/*extra*/.dr-table-firstrow.hover .dr-table-cell {background-color:#009ad7; color:#036;}\r\n/*extra*/.dr-table-header.hover td, .dr-table-header.hover th {background-color:#fff;}\r\n/*extra*/.dr-table-footer.hover td {background-color:#fff;}\r\n\r\n/* ----------------------------------------------------------------------------------------------- */\r\n\r\n\r\n\r\n\r\n\r\n/*RICH DATASCROLLER old\r\ntd.rich-mpnl-body {background-image:none;}\r\ntd.rich-mpnl-body table.hovertable tbody td {padding-left:5px;}\r\ntd.rich-mpnl-body table.hovertable tfoot td {background-color:#0078D2;}\r\ndiv.rich-datascr {font-weight:normal; border:0;}\r\n.rich-datascr .rich-dtascroller-table{border-width:0px;border-style:solid; }\r\n.rich-datascr .rich-dtascroller-table td {background-image:none; background-color:#fff; padding:2px 5px 2px 5px;}\r\ntable.hovertable thead td .rich-dtascroller-table tr.hovertablerow td{background-color:#fff;}\r\ntable.hovertable tfoot td .rich-dtascroller-table tr.hovertablerow td{background-color:#fff;}\r\n.rich-datascr .rich-dtascroller-table .rich-datascr-button, .rich-datascr .rich-dtascroller-table .rich-datascr-ctrls-separator{border:1px solid #fff;width:25px;cursor:pointer;text-align:center;}\r\n.rich-datascr .rich-dtascroller-table .rich-datascr-button-dsbld{cursor:default;}\r\n.rich-datascr .rich-dtascroller-table .rich-datascr-act{background-color:#0078D2; color:#FFF; width:25px;text-align:center;}\r\n.rich-datascr .rich-dtascroller-table .rich-datascr-inact{border-bottom:2px solid #fff;border-top:2px solid #fff;width:25px;cursor:pointer;text-align:center;}\r\n.rich-datascr .rich-dtascroller-table .rich-datascr-button-dsbld{color:gray;}\r\n*/\r\n\r\n\r\n/* SIMPLE TOGGLE PANEL */\r\n.dr-stglpnl { border:0px; padding:0px; background-color:#fff; }\r\n.dr-stglpnl-h { border:1px solid #036; border-bottom:0px; padding:3px 5px 5px 5px; color:#fff; font-weight:bold; background:#036 url(../images/verloop-blauw.gif) left bottom repeat-x; cursor:pointer; }\r\n.dr-stglpanel-marker { float:left; color:#fff; vertical-align:middle;}\r\n.dr-stglpnl-m { padding-right:3px; }\r\n.dr-stglpnl-b { border:1px solid #036; border-top:0px; padding:5px; text-align:left; vertical-align:top; overflow:auto; }\r\n\r\n/* ----------------------------------------------------------------------------------------------- */\r\n/* Default attributes of table container for entire calendar */\r\n.jscalendar-DB-table-style {\r\n    font-family:Verdana;\r\n    font-size:1em;\r\n    border-width:1px;\r\n    border-style:solid;\r\n    border-color:#001b4d;\r\n\tbackground-color: #ffffff;\r\n}\r\n.jscalendar-DB-table-style td {\r\n\tbackground-image:none;\r\n\tpadding: 2px;\r\n}\r\n.jscalendar-DB-table-style td a, .jscalendar-DB-table-style td a:hover{\r\n    font-family:Verdana;\r\n    font-size:1em;\r\n}\r\n/* Default attributes of DIV containing table container for entire calendar.\r\n * You probably don't want to alter this style.\r\n */\r\n.jscalendar-DB-div-style {\r\n\tz-index: +999;\r\n\tposition: absolute;\r\n\tvisibility: hidden;\r\n}\r\n\r\n/* Default attributes used in calendar title (month and year columns).*/\r\n.jscalendar-DB-title-style {\r\n    padding:2px;\r\n    font-family:Verdana;\r\n    font-size:1em;\r\n    font-weight:bold;\r\n    color:#FFFFFF;  \r\n    width:auto;  \r\n}\r\n\r\n/* Default attributes used in calendar title background.*/\r\n.jscalendar-DB-title-background-style {\r\n\tbackground-image:none;\r\n\tborder:0;\r\n\tbackground-color: #0000aa;\r\n}\r\n\r\n.jscalendar-DB-title-background-style td table tr {\r\n\tbackground-image:none;\r\n\tborder:0;\r\n\tbackground-color: #0000aa;\r\n}\r\n\r\n/* Normal appearance of controls in calendar title. */\r\n/* Note: The right, left and down icons are images, jscalendar-DBich must be edited if you need to change them. */\r\n.jscalendar-DB-title-control-normal-style {\r\n\tborder-style: solid;\r\n\tborder-width: 1px;\r\n\tborder-color: #0000aa;\r\n\tcursor: pointer;\r\n    font-family:Verdana;\r\n    font-size:1em\t\r\n}\r\n\r\n/* Normal appearance of images in calendar title. */\r\n/* Note: The right, left and down icons are images, jscalendar-DBich must be edited if you need to change them. */\r\n.jscalendar-DB-title-img-normal-style {\r\n\tcursor: pointer;\r\n}\r\n\r\n/* Moused-over (selected) appearance of controls in calendar title. */\r\n.jscalendar-DB-title-control-select-style {\r\n\tborder-style: solid;\r\n\tborder-width: 1px;\r\n\tborder-color: #5286ce;\r\n\tcursor: pointer;\r\n}\r\n\r\n/* Moused-over (selected) appearance of controls in calendar title. */\r\n.jscalendar-DB-title-img-select-style {\r\n\tcursor: pointer;\r\n}\r\n\r\n/* Default attributes of drop down lists (month and year). */\r\n.jscalendar-DB-dropdown-style {\r\n\tfont-family:Verdana;\r\n\tfont-size: 1em;\r\n\tborder-width: 1px;\r\n\tborder-style: solid;\r\n\tborder-color: #001b4d;\r\n\tbackground-color: #fff;\r\n\tcolor:#001b4d;\r\n\tcursor: pointer;\r\n}\r\n\r\n.jscalendar-DB-dropdown-style td {background-image:none;}\r\n\r\n/* Default attributes selected (mouse-over) item in drop down lists (month and year). */\r\n.jscalendar-DB-dropdown-select-style {\r\n\tbackground-color: #c8ddfa;\r\n}\r\n\r\n/* Default attributes unselected (mouse-off) item in drop down lists (month and year). */\r\n.jscalendar-DB-dropdown-normal-style {\r\n\tbackground-color:none;\r\n}\r\n\r\n.jscalendar-DB-body-style a:hover {font-family:Verdana; font-weight:1em; background-color: #fff;\r\n\ttext-decoration:none;\r\n\tcolor:#001b4d;\r\n\tfont-weight:normal;\r\n\tborder:1px solid #001b4d;}\r\n\t\r\n/* Default attributes of calendar body (weekday titles and numbers). */\r\n.jscalendar-DB-body-style {\r\n\tbackground-color: #FFFFFF;\r\n\tfont-family: Verdana;\r\n\tfont-size: 1em;\r\n}\r\n.jscalendar-DB-body-style td {width:27px; padding-left:2px; padding-right:2px; }\r\n\r\n/* Attributes of current day in calendar body. */\r\n.jscalendar-DB-current-day-style {\r\n\tcolor: #fff;\r\n\tfont-weight: normal;\r\n\ttext-decoration: none;\r\n\tborder:1px solid #5286ce;\r\n\tbackground-color:#5286ce;\r\n}\r\n\r\n/* Attributes of end-of-week days (Sundays) in calendar body. */\r\n.jscalendar-DB-end-of-weekday-style {\r\n\tcolor: #909090;\r\n\ttext-decoration: none;\r\n\tborder: 1px solid #fff;\r\n}\r\n\r\n/* Attributes of all other days in calendar body. */\r\n.jscalendar-DB-normal-day-style {\r\n\tcolor: #001b4d;\r\n\ttext-decoration: none;\r\n\tborder: 1px solid #fff;\r\n}\r\n\r\n.jscalendar-DB-would-be-selected-day-style {\r\n\tbackground-color: #fff;\r\n\ttext-decoration:none;\r\n\tcolor:#001b4d;\r\n\tfont-weight:bold;\r\n}\r\n\r\n\r\n/* Attributes of border around selected day in calendar body. */\r\n.jscalendar-DB-selected-day-style {\r\n\tborder-style: solid;\r\n\tborder-width: 1px;\r\n\tborder-color: #001b4d;\r\n\tfont-weight: normal;\r\n\tcolor: #001b4d;\r\n}\r\n\r\n/* Default attributes of designated holidays. */\r\n.jscalendar-DB-holiday-style {\r\n\tbackground-color: #FFDDDD;\r\n}\r\n\r\n/* Attributes of today display label at bottom on calendar */\r\n.jscalendar-DB-today-lbl-style {\r\n\tpadding: 5px;\r\n\ttext-align: center;\r\n\tbackground-color:#5286ce;\r\n\tcolor:#fff;\r\n}\r\n\r\n/* Attributes of today display at bottom on calendar */\r\na.jscalendar-DB-today-style {\r\n\tpadding: 2px;\r\n\tcolor: #fff;\r\n\ttext-align: center;\r\n\ttext-decoration: none;\r\n\twidth:100px;\r\n\tbackground-color:#5286ce;\r\n\tfont-family: Verdana;\r\n\tfont-size: 1em;\t\r\n}\r\n\r\na.jscalendar-DB-today-style:hover  {\r\n\tcolor: #fff;\r\n\ttext-decoration: none;\r\n\tbackground-color:#5286ce;\r\n\tfont-family: Verdana;\r\n\tfont-size: 1em;\r\n}\r\n\r\n/* Attributes of week number division (divider.gif) */\r\ntd.jscalendar-DB-weeknumber-div-style img {display:none;}\r\ntd.jscalendar-DB-weeknumber-div-style {\r\n\tbackground-color: #5286ce;\r\n\tpadding: 0px;\r\n\twidth:1px;\r\n}\r\n\r\n/* Attributes of week labels in calendar. */\r\n.jscalendar-DB-normal-week-style {\r\n\tcolor: #001b4d;\r\n\ttext-decoration: none;\r\n\tfont-weight:bold;\r\n}\r\n\r\n.jscalendar-DB-would-be-selected-week-style {\r\n\tbackground-color: #EEEEEE;\r\n}\r\n\r\n/* Rich Calender Styling */\r\nimg.rich-calendar-button {width:20px; height:21px; vertical-align:bottom; position:relative; top:-1px; /*left:2px;*/ clear:none; float:left; /*margin-right:5px;*/}\r\n\r\n.rich-calendar-exterior {border:1px solid #036;}\r\n.rich-calendar-exterior tr {background:none;}\r\n\r\n.rich-calendar-header {background-color:#036; color:#fff; border:0px;}\r\n.rich-calendar-header table {margin:0px; background-color:#036; color:#fff;}\r\n\r\n.rich-calendar-tool {background:#036;}\r\n.rich-calendar-header .rich-calendar-tool-btn {text-decoration:none; border:0px; padding:2px;}\r\n.rich-calendar-footer .rich-calendar-tool-btn {text-decoration:none; border:0px; padding:2px;}\r\n.rich-calendar-toolfooter {vertical-align:middle;}\r\n\r\n.rich-calendar-days {background-color:#cccb14;}\r\n.rich-calendar-days {border:0px; border-bottom:1px solid #036;}\r\n.rich-calendar-week {background-color:#006bb2; color:#fff;}\r\n.rich-calendar-week {border:0px; border-right:1px solid #036; border-bottom:1px solid #036;}\r\n.rich-calendar-weekends {color:#fff;}\r\n\r\n.rich-calendar-cell-size {}\r\n.rich-calendar-cell {border-right:1px solid #036; border-bottom:1px solid #036;}\r\n.rich-right-cell {border:0px; border-bottom:1px solid #036;}\r\n.rich-bottom-cell {border:0px; border-right:1px solid #036;}\r\n.rich-calendar-btn {background-color:#009ad7;}\r\n\r\n.rich-calendar-holly {background-color:#e8efb2; color:#969500;}\r\n.rich-calendar-today {font-weight:bold;}\r\n.rich-calendar-boundary-dates {background-color:#fff; color:#999;}\r\n.rich-calendar-footer {padding:2px; border-top:1px solid #036; background-color:#fff;}\r\n.rich-calendar-footer table {margin:0px; color:#036; background-color:#fff;}\r\n.rich-calendar-toolfooter {vertical-align:middle;}\r\n\r\n.rich-calendar-select {background-color:#fff;}\r\n/* IE6 */\r\n.rich-calendar-header .rich-calendar-tool-btn.rich-calendar-tool-btn-hover {text-decoration:underline; color:#fff; border:0px; padding:2px;}\r\n.rich-calendar-footer .rich-calendar-tool-btn.rich-calendar-tool-btn-hover {text-decoration:underline; color:#036; border:0px; padding:2px;}\r\n\r\n.rich-calendar-btn.rich-calendar-hover {background-color:#fff; font-weight:bold;}\r\n.rich-calendar-exterior tbody tr.hover td.rich-calendar-days {background-color:#cccb14;}\r\n.rich-calendar-exterior tbody tr.hover td.rich-calendar-week {background-color:#006bb2;}\r\n\r\n/* IE7 */\r\n.rich-calendar-exterior tbody tr:hover td.rich-calendar-days {background-color:#cccb14;}\r\n.rich-calendar-exterior tbody tr:hover td.rich-calendar-week {background-color:#006bb2;}\r\n.rich-calendar-exterior tbody tr:hover td.rich-calendar-boundary-dates {background-color:#fff;}\r\n.rich-calendar-exterior tbody tr:hover td.rich-calendar-footer {background-color:#fff;}\r\n.rich-calendar-exterior tbody tr:hover td.rich-calendar-footer table tr td {background-color:#fff;}\r\n.rich-calendar-exterior tbody tr:hover td.rich-calendar-header {background-color:#036;}\r\n.rich-calendar-exterior tbody tr:hover td.rich-calendar-header table tr td {background-color:#036;}\r\n.rich-calendar-exterior tbody tr:hover td.rich-calendar-holly.rich-calendar-btn.rich-calendar-hover {background-color:#fff;}\r\n.rich-calendar-exterior tbody tr:hover td.rich-calendar-holly {background-color:#e8efb2;}\r\n.rich-calendar-exterior tbody tr:hover td.rich-calendar-holly.rich-calendar-boundary-dates {background-color:#fff;}\r\n.rich-calendar-exterior tbody tr:hover td.rich-calendar-select {background-color:#fff;}\r\n\r\n/* SUGGESTION BOX */\r\n.rich-sb-common-container {position:absolute; text-align:left; background-color:#fff;}\r\n.rich-sb-ext-decor-1 {padding:0; position:absolute; height:100%; width:100%; z-index:2; background-color:#fff;}\r\n.rich-sb-ext-decor-1 td {padding:0;}\r\n.rich-sb-ext-decor-2 {padding:0; border:1px solid #001b4d; height:100%; width:100%; background-color:#fff;}\r\n.rich-sb-ext-decor-2 td {padding:0;}\r\n.rich-sb-ext-decor-3 {padding:0; height:100%; width:100%; background-color:#fff;}\r\n.rich-sb-ext-decor-3 td {background-image:none; padding:0;}\r\n.rich-sb-overflow {overflow:auto;}\r\n.rich-sb-int-decor-table {width:100%;}\r\n.rich-sb-int-decor-table td {background:url(../images/stippellijn-blauw.gif) left bottom repeat-x;}\r\n.rich-sb-shadow {position:absolute; height:100%; width:100%; border:1px solid #deeef9; background-color:#deeef9; z-index:1; }\r\n.rich-sb-int-decor-table .rich-sb-cell-padding {padding:1px 3px 2px 5px;}\r\n.rich-sb-int {cursor:pointer;}\r\n.rich-sb-int-sel td {cursor:pointer; background:#deeef9 url(../images/stippellijn-blauw.gif) left bottom repeat-x;}\r\n\r\n/* ----------------------------------------------------------------------------------------------- */\r\n.rich-panelbar { border:1px solid; padding:1px;}\r\n.rich-panelbar-interior { border-bottom:0!important; }\r\n.rich-panelbar-header { border:0 solid red; padding:0 1px 1px 5px; cursor:pointer; }\r\n.rich-panelbar-header-act { border:0 solid red; padding:0 1px 1px 5px; cursor:pointer; }\r\n.rich-panelbar-content { padding:10px; text-align:left; vertical-align:top; }\r\n.rich-panelbar-b { border-top-width:0!important; border-left-width:0!important; border-right-width:0!important; padding:0; }\r\n.rich-panelbar-header { background-image:url(/cbbs/a4j/g/3_3_2.SR1org.richfaces.renderkit.html.GradientA.jsf); background-position:top left; background-repeat:repeat-x; vertical-align:middle; }\r\n.rich-panelbar-header-act { background-image:url(/cbbs/a4j/g/3_3_2.SR1org.richfaces.renderkit.html.GradientA.jsf); background-position:top left; background-repeat:repeat-x; vertical-align:middle; }\r\n/* ----------------------------------------------------------------------------------------------- */\r\n\r\n.rich-container input, .rich-input, .rich-container select, .rich-select, .rich-container textarea, .rich-textarea, .rich-container button, .rich-button, .rich-container keygen, .rich-keygen, .rich-container isindex, .rich-isindex { border-width:1px; }\r\n.rich-container *|button, .rich-button {\r\nborder-width:1px;\r\nbackground-repeat:repeat-x;\r\nbackground-position:top left;\r\n}\r\n.rich-button, .rich-container button[type=\"button\"], .rich-button-button, .rich-container button[type=\"reset\"], .rich-button-reset, .rich-container button[type=\"submit\"], .rich-button-submit, .rich-container input[type=\"reset\"], .rich-input-reset, .rich-container input[type=\"submit\"], .rich-input-submit, .rich-container input[type=\"button\"], .rich-input-button { border-width:1px; background-repeat:repeat-x; background-position:top left; }\r\n.rich-container *|button, .rich-button {\r\nbackground-image:url(/cbbs/page/a4j/g/3_2_2.SR1org.richfaces.renderkit.html.images.ButtonBackgroundImage/DATB/eAFjYGDgBgAADwAM);\r\n}\r\n.rich-button, .rich-container button[type=\"button\"], .rich-button-button, .rich-container button[type=\"reset\"], .rich-button-reset, .rich-container button[type=\"submit\"], .rich-button-submit, .rich-container input[type=\"reset\"], .rich-input-reset, .rich-container input[type=\"submit\"], .rich-input-submit, .rich-container input[type=\"button\"], .rich-input-button, {\r\nbackground-image:url(/cbbs/page/a4j/g/3_2_2.SR1org.richfaces.renderkit.html.images.ButtonBackgroundImage/DATB/eAFjYGDgBgAADwAM);\r\n}\r\n.rich-container *|button[disabled] {\r\nbackground-image:url(/cbbs/page/a4j/g/3_2_2.SR1org.richfaces.renderkit.html.images.ButtonDisabledBackgroundImage/DATB/eAFjYGDgBgAADwAM);\r\n}\r\n.rich-button-disabled, .rich-container button[type=\"button\"][disabled], .rich-button-button-disabled, .rich-container button[type=\"reset\"][disabled], .rich-button-reset-disabled, .rich-container button[type=\"submit\"][disabled], .rich-button-submit-disabled, .rich-container input[type=\"reset\"][disabled], .rich-input-reset-disabled, .rich-container input[type=\"submit\"][disabled], .rich-input-submit-disabled, .rich-container input[type=\"button\"][disabled], .rich-input-button-disabled { background-image:url(/cbbs/page/a4j/g/3_2_2.SR1org.richfaces.renderkit.html.images.ButtonDisabledBackgroundImage/DATB/eAFjYGDgBgAADwAM); }\r\n.rich-container *|textarea {\r\nborder-width:1px;\r\nborder-style:inset;\r\nbackground-repeat:no-repeat;\r\nbackground-position:1px 1px;\r\n}\r\n.rich-textarea, .rich-container textarea[type=\"textarea\"], .rich-textarea-textarea, .rich-container input[type=\"text\"], .rich-input-text, .rich-container input[type=\"password\"], .rich-input-password, .rich-container select, .rich-select { border-width:1px; border-style:inset; background-repeat:no-repeat; background-position:1px 1px; }\r\n.rich-container *|textarea {\r\nbackground-image:url(/cbbs/page/a4j/g/3_2_2.SR1org.richfaces.renderkit.html.images.InputBackgroundImage/DATB/eAFjYGDgBgAADwAM);\r\n}\r\n.rich-textarea, .rich-container textarea[type=\"textarea\"], .rich-textarea-textarea, .rich-container input[type=\"text\"], .rich-input-text, .rich-container input[type=\"password\"], .rich-input-password, .rich-container select, .rich-select { background-image:url(/cbbs/page/a4j/g/3_2_2.SR1org.richfaces.renderkit.html.images.InputBackgroundImage/DATB/eAFjYGDgBgAADwAM); }\r\n/* ----------------------------------------------------------------------------------------------- */\r\n.rich-container fieldset, .rich-fieldset { border-width:1px; border-style:solid; padding:10px; }\r\n.rich-container hr, .rich-hr { border-width:1px; border-style:solid; }\r\n.rich-container legend, .rich-legend { font-weight:bo