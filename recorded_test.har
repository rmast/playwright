          "content": {
            "size": -1,
            "mimeType": "text/css",
            "text": "@charset \"utf-8\";\r\n/* CSS Document */\r\n\r\n/* ------------------------------------------ */\r\n/*                 OVERALL                    */\r\n/* for dev&test set resolution to 1680 x 1050 */\r\n/* or 1366 * 768 for laptop (ADA)\r\n/* ------------------------------------------ */\r\n\r\n@font-face {\r\n  font-family: 'open sans';\r\n  src: url('../../font/Regular.ttf');\r\n  font-style:normal;\r\n  font-weight:400;\r\n}\r\n\r\n@font-face {\r\n  font-family: 'open sans';\r\n  src: url('../../font/Bold.ttf');\r\n  font-style:bold;\r\n  font-weight:700;\r\n}\r\n\r\n@font-face {\r\n  font-family: 'open sans';\r\n  src: url('../../font/SemiBold.ttf');\r\n  font-style:semibold;\r\n  font-weight:600;\r\n}\r\n@font-face {\r\n  font-family: 'open sans';\r\n  src: url('../../font/open-sans-v17-latin-regular.eot?#iefix');\r\n  font-style:normal;\r\n  font-weight:400;\r\n}\r\n\r\n@font-face {\r\n  font-family: 'open sans';\r\n  src: url('../../font/open-sans-v17-latin-700.eot?#iefix');\r\n  font-style:bold;\r\n  font-weight:700;\r\n}\r\n\r\n@font-face {\r\n  font-family: 'open sans';\r\n  src: url('../../font/open-sans-v17-latin-600.eot?#iefix');\r\n  font-style:semibold;\r\n  font-weight:600;\r\n}\r\nbody {margin:0; padding:0; border:0; text-align:left; font-family:Open Sans; font-size:0.8em; color:#001b4d;}\r\n\r\n/* headings */\r\nh1 {display:block; clear:both; margin:0em 0 0.7em 0; padding:0 0 0.2em 0; color:#001b4d; font-size:1.5em; font-weight:bold; border-bottom:1px solid #009ad7; position:relative;}\r\nh2 {display:block; clear:both; margin:0; padding:0.4em 0 0.25em 0; color:#001b4d; font-size:1.2em; font-weight:bold;}\r\nh3 {display:block; clear:both; margin:0; padding:0 0 0.2em 10px; color:#001b4d; font-size:1.1em; font-weight:bold;}\r\nh4, .postFix {margin:0; padding:0; color:#666; font-size:0.9em; font-weight:normal; }\r\nh4 {clear:both;}\r\nh5 {font-size:0.692em; font-weight:normal;}\r\nh6 {font-size:0.615em; font-weight:normal;}\r\np {margin:0; padding:0.2em 0 0.2em 0;}\r\npre {font-family:Open Sans; margin:0; padding:0 0 5px 10px;}\r\n.nowrap {white-space:nowrap;}\r\n.bold {font-weight:bold;}\r\n.alert {font-weight:800; color:#009ad7;}\r\n.linkVisited {font-weight:bold; color:#0078D2;}\r\n.paddingVisited {padding: 0px 10px 10px 0;}\r\n.dynamicStyle {\r\n  border: 1px solid;\r\n  padding: 7px;\r\n  background-color: rgba(213, 238, 251, 0.5);\r\n  box-shadow: 2px 2px 0px 0px rgba(0, 0, 0, 0.5);\r\n}\r\n.classificatie {color:#009ad7; font-weight:bold; text-align:right; font-size:0.9em; margin-right:0.4em;}\r\n/* waarschuwing startpagina */\r\n.warning {width:100%; clear:both; margin:0.5em 0 1.5em 0; background-color:#deeef9; text-align:left;}\r\n.warning p {padding:0.4em; color:#009ad7; font-weight:bold; font-size:0.9em;}\r\n.blokkeer {color:#f00;}\r\n\r\n\r\n/* algemene link */\r\na {color:#001b4d; font-weight:normal; text-decoration:underline;}\r\na:hover {color:#009ad7; text-decoration:underline; cursor:pointer;}\r\na.actief {color:#009ad7; font-weight:bold; text-decoration:none;}\r\nth a {font-weight:bold; color:#fff; text-decoration:none; cursor:pointer}\r\nth a:hover {text-decoration:underline; cursor:pointer}\r\na img {border:0;}\r\n\r\nh2 a {color:#001b4d; font-size:1em; font-weight:normal; text-decoration:underline;}\r\nh2.kop {background-color:#deeef9; font-weight:bold; text-decoration:underline; padding:3px 3px 5px 15px; }\r\nh2.kop a {font-weight:bold;}\r\n\r\n.divider {padding:0 0.4em 0 0.4em;}\r\n.pointer {cursor:pointer;}\r\n.noborder {border:0; background:none;}\r\n.hidden, .hide {display:none;}\r\n.bg-highlight {background-color:#deeef9;}\r\n.highlight {font-weight:bold; background-color:#deeef9;}\r\n\r\n.klapuit {background:url(../images/arrow-right.gif) left center no-repeat; padding-left:20px; }\r\n.klapin {background:url(../images/arrow-right.gif) left center no-repeat; padding-left:20px; }\r\n\r\n.hiddenrow {display: none;}\r\n/* ------------------------------------------ */\r\n/*      HEADER, MAINMENU, KRUIMELPAD          */\r\n/* ------------------------------------------ */\r\n\r\n/* header */\r\n.wrapper {margin:0; padding:0; height:1%;}\r\n.header {width:100%; height:90px; background-color:#fff; z-index:1;}\r\n.header img.logo {position:absolute; top:10px; left:20px; z-index:10}\r\n.header .titel {float:left; background:url(../images/cbbs_titel.gif) left top no-repeat; width:557px; height:69px;}\r\n.header .titel span {display:none;}\r\n.header div.ingelogd {position:relative; float:right; margin-right:2em; top:0.6em; z-index:999;}\r\n\r\n/* mainmenu */\r\n#mainmenu_spoed_melding_wrapper{ background-color:#D5EEFB; color: red; font-size: 16px; font-weight: bold;}\r\n#mainmenu_spoed_melding_margin{ margin-left: 30px; }\r\n#mainmenu_spoed_melding{ margin-left: 0px; }\r\n.mainmenu {width:100%; height:25px; margin:0 0 0 0; padding:20px 0px 0px 0px; text-align:left; z-index:3; position:relative; background-color:#D5EEFB;}\r\n.mainmenu ul {margin:0px; padding:5px 0 0 114px; list-style:none;}\r\n.mainmenu ul li {display:inline; margin-right:-5px; font-weight:normal; font-size:12px; white-space:nowrap;}\r\n.mainmenu ul li a {margin:0; padding:3px 15px 11px; color:#001b4d; font-weight:bold; text-decoration:none;}\r\n.mainmenu ul li a:hover {color:#009ad7;}\r\n.mainmenu ul li.actief {margin-right:-3px; margin-left:2px;}\r\n.mainmenu ul li.actief a {padding:8px 10px 8px 10px; color:#001b4d; font-weight:bold; text-decoration:none; background-color:#fff;}\r\n.mainmenu ul li.actief a:hover {color:#009ad7; background-color:#fff;}\r\n.mainmenu ul li.inactief {margin-right:-3px; padding:5px 10px 5px 10px; border:1px solid #001b4d; color:#666; background-color:#c8c8c8;}\r\n/* rechts uitgelijnd op menubalk */\r\n.mainmenu ul li ul {float:right; Margin:-11px 4px 0px 0px; padding:9px 0 10px 5px; border:0;}\r\n.mainmenu ul li ul li {margin-left:-5px; margin-right:0; background-color:#D5EEFB;}\r\n.mainmenu ul li ul li.actief {margin-left:-3px; margin-right:2px; padding-bottom:10px;}\r\n.mainmenu ul li ul li.actief a {white-space:nowrap;}\r\n/* mainmenu zoekbalk */\r\n\r\n/* submenu */\r\n.submenu {width:100%; margin:-0.71em 0 0 0; padding:0.5em 0; text-align:left;  position:relative; z-index:2;}\r\n.submenu ul {margin:-9px 0 0 0; padding:10px 0 0.5em 190px; list-style:none; border-bottom:1px solid #001b4d;}\r\n.submenu ul li {display:inline; margin:0; padding:0; font-weight:normal; white-space:nowrap;}\r\n.submenu ul li a {margin:0; padding:0 0.8em 0 0.8em; color:#001b4d; text-decoration:none; }\r\n.submenu ul li a:hover {color:#009ad7; text-decoration:underline;}\r\n.submenu ul li.actief a {color:#001b4d; font-weight:bold;}\r\n.submenu ul li.actief a:hover {color:#009ad7; font-weight:bold; text-decoration:underline;}\r\n\r\n/* dropping down hoofdmenu */\r\n.mainmenu .nav {margin-right:15px;}\r\n.nav, .nav ul {padding:3px; list-style:none;}\r\n.nav ul {margin:0;}\r\n.nav li {float:left; width:auto; margin:-5px 0 0 4px;}\r\n.nav li.rechts {float:right;}\r\n.mainmenu ul.nav li a, .mainmenu ul.nav li ul li a, .mainmenu ul.nav li.rechts a {font-weight:600; font-size:1.2em;}\r\n.nav li ul {position:absolute; width:135px; left:-1000px; padding-left:0;}\r\n.nav li ul li {margin-top:-6px; padding-right:1em; width:148px;}\r\n.nav li ul li ul {margin:-33px 0 0 129px;}\r\n.nav li:hover ul, .nav li.ie_does_hover ul {left:auto; background-position:0 0;}\r\n.nav li:hover ul li ul, .nav li.ie_does_hover ul li ul {left:-999em;}\r\n\r\n.nav li:hover ul, .nav li ul li:hover ul,\r\n.nav li.ie_does_hover ul, .nav li.ie_does_hover ul li.ie_does_hover ul\r\n{left:auto;}\r\n\r\n.nav a {display:block; margin:0; text-decoration:none; font-family:Open Sans; font-size:1.1em; color:#001b4d; cursor:pointer;}\r\n\r\n.nav li ul li a, .nav li ul li ul li a {font-weight:normal; cursor:pointer;}\r\n.nav a:link, .nav a:visited, .nav a:active {font-weight:normal; color:#001b4d;}\r\n.nav li a:hover {color:#009ad7;}\r\n/* met actief menu item */\r\n.nav li.act { margin-top:-8px; padding-top:0px; margin-right:-3px; margin-left:6px;}\r\n.nav li.act a {padding: 3px 20px 11px; background-color:#fff; color:#001b4d; font-weight:bold; border-radius: 6px 6px 0 0; font-size:1.2em;}\r\n.nav li.act ul li a {padding:5px; background-color:#deeef9; color:#0078D2; font-weight:normal; margin-left:10px; font-size:1.2em;}\r\n.nav li.act ul li ul {margin-top:-34px;}\r\n.nav li.act ul li a:hover {color:#009ad7;}\r\n\r\n/* --------------------------------------------------------------------- */\r\n/*                  CONTENT                                     CONTENT  */\r\n/* --------------------------------------------------------------------- */\r\n.contentarea {position:relative; min-height:100%; height:100%; width:auto; vertical-align:top; padding:0% 2% 0% 2%;}\r\n.div.contentarea {min-width:990px;}\r\nhtml>body .contentarea {height:1%;}\r\n\r\nform {margin:0; padding:0; clear:both; display:block; font-size:1.0em;}\r\nform div.floatleft {display:block; float:left; width:49%; clear:none; padding:5px; margin:0;}\r\nform div.floatright {float:right; clear:none; position:relative; padding:0; margin:3px 0 0 0;}\r\nform div.paddingright {padding-right:15px;}\r\nform div.links {width:77%; position:relative; clear:none; float:left;}\r\nform div.rechts {position:relative; clear:none; float:right; width:22%;}\r\nform .fixedsize {width:500px; float:left; clear:none; overflow:auto; border:0; padding:0; margin:0; margin-bottom:1em;}\r\nform .fixedsize2 {width:510px; float:left; clear:none; overflow:auto; border:0; padding:0; margin:0; margin-bottom:1em;}\r\nform .variablesize {float:left; clear:none; border:0; padding:0; margin:0; margin-bottom:1em;}\r\nform .border {border:1px solid #001b4d;}\r\nform .marginright {margin:0 10px 0 0;}\r\nform .overzicht {float:left; background-color:#deeef9; padding:0.5em; width:99%;}\r\nform .zoekresultaat {display:block; clear:both;}\r\nform .tabcontent .functiebelastingPagina {width:1366px;}\r\n\r\n/* status regel */\r\n.status {display:block; clear:both; width:100%; margin-bottom:5px;}\r\n.status span {display:block; float:left; clear:none; margin-right:-1px; border:0; padding:1px 5px 5px 5px; color:#666; background-color:#fff; white-space:nowrap; font-size:1.0em;}\r\n\r\n/* ------------------------------------------ */\r\n/*      LOGIN POPUP                           */\r\n/* ------------------------------------------ */\r\n.infoFont {font-size:1.3em;}\r\n.infoRow {margin-left:192px; background:none;}\r\n.infoLabel {width:165px;}\r\n.infoIndent {margin-left:192px;}\r\n.infoIndentText {margin-left:182px;}\r\n.infoButton {padding:1px 10px 2px 10px; border:2px solid #001b4d; margin-left:195px;}\r\n\r\n/* ------------------------------------------ */\r\n/*                  TABS                      */\r\n/* ------------------------------------------ */\r\n/* horizontale tabs met tabcontent div eronder */\r\n.tabs {display:block; position:relative; clear:both; margin:2px 0 0 0; padding:1px 0 0 0; text-align:left; background-color:#fff; z-index:2; white-space:nowrap;}\r\n.tabs ul {margin:0; padding:4px; list-style:none;}\r\n.tabs ul li, .tabs ul li.active {display:inline; margin:0 -3px 0 0;}\r\n.tabs ul li.active span, .tabs ul li.active a {margin:0px 2px 0px 2px; border:1px solid #001b4d; border-bottom:1px solid #fff; padding:6px 12px 3px 12px; color:#001b4d; font-weight:bold; background-color:#fff; border-radius: 5px 5px 0px 0px; font-size:1.1em;}\r\n.tabs ul li.inactive a {margin:0px 2px 0px 2px; border:1px solid #001b4d; border-bottom:0; padding:6px 12px 4px 12px; color:#001b4d; background-color:#e5f0f7; font-weight:normal; border-radius: 5px 5px 0px 0px; font-size:1.1em;}\r\n.tabs ul li.inactive-completed a {margin:0px 2px 0px 2px; border:1px solid #001b4d; border-bottom:0; padding:6px 12px 4px 12px; color:#001b4d; background-color:#e8efb2; font-weight:normal; border-radius: 5px 5px 0px 0px; font-size:1.1em;}\r\n.tabs ul li.disabled {margin:0px 2px 0px 2px; border:1px solid #666; border-bottom:0; padding:6px 12px 4px 12px; color:#666; background-color:#f0f0f0; border-radius: 5px 5px 0px 0px; font-size:1.1em;}\r\n.tabs ul li a {text-decoration:none;}\r\n.tabs ul li a:hover {background-color:#fff;}\r\n.tabcontent {display:block; clear:both; margin:0px 0 10px 0; border-top:1px solid #001b4d; border-right:0; border-bottom:0; border-left:1px solid #001b4d; padding:5px 15px 5px 15px; position:relative; top:0px; z-index:1; width:99%; height:100%;}\r\n\r\n/* verticale tabs met tabcontent div rechts ernaast */\r\n.tabs-verticaal, .tabs-verticaal-2 {float:left; height:100%; margin:10px 0 0 0; padding:0; text-align:left; background-color:#fff; position:relative; z-index:4;}\r\n.tabs-verticaal ul, .tabs-verticaal-2 ul {margin:0; padding:0; list-style:none; position:relative; left:1px;}\r\n.tabs-verticaal ul li, .tabs-verticaal-2 ul li {margin:0; margin-bottom:1px; padding:0; cursor:pointer;}\r\n.tabs-verticaal ul li input {display:block; width:16em; margin:0; border:1px solid #969500; border-right:1px solid #001b4d; overflow:visible; padding:7px 4px 7px 7px; color:#001b4d; font-weight:normal; text-align:left; text-decoration:none; background-color:#e8efb2;}\r\n.tabs-verticaal-2 ul li input {display:block; width:24em; margin:0; border:1px solid #969500; border-right:1px solid #001b4d; overflow:visible; padding:7px 4px 7px 7px; color:#001b4d; font-weight:normal; text-align:left; text-decoration:none; background-color:#e8efb2;}\r\n.tabs-verticaal ul li.active, .tabs-verticaal-2 ul li.active {/*width:165px;*/ border:1px solid #001b4d; border-right:1px solid #fff; padding:0px; font-weight:bold; background-color:#fff; z-index:7;}\r\n.tabs-verticaal ul li.active input, .tabs-verticaal-2 ul li.active input {border:0; background-color:#fff; overflow:visible; white-space:normal; font-weight:bold; cursor:pointer;}\r\n.tabs-verticaal ul li.inactive, .tabs-verticaal-2 ul li.inactive {border:1px solid #7f9db9; border-right:1px solid #001b4d; color:#969500;}\r\n.tabs-verticaal ul li.inactive input, .tabs-verticaal-2 ul li.inactive input {border:0; background-color:#eff6fc; overflow:visible; white-space:normal; cursor:pointer;}\r\n.tabs-verticaal ul li.selected input, .tabs-verticaal-2 ul li.selected input {font-weight:bold;}\r\n.tabcontent-verticaal {display:block; width:83%; background-color:#fff; float:left; margin-bottom:10px; border-top:1px solid #001b4d; border-right:0; border-bottom:0; border-left:1px solid #001b4d; padding:5px; position:relative; z-index:3; clear:right;}\r\n.tabcontent-verticaal table th {white-space:normal;}\r\n.tabcontent-verticaal-2 {display:block; width:74%; background-color:#fff; float:left; margin-bottom:10px; border-top:1px solid #001b4d; border-right:0; border-bottom:0; border-left:1px solid #001b4d; padding:5px; position:relative; z-index:3; clear:right;}\r\n.tabcontent-verticaal-2 table th {white-space:normal;}\r\n\r\n/* .tabs-verticaal.lang ul li a {width:250px;} */\r\n/* .tabs-verticaal.lang ul li.active {width:250px;} */\r\n/* .tabs-verticaal.lang ul li.inactive {width:250px;} */\r\n\r\n/*quicklink */\r\n.quicklink {float:left;}\r\n.quicklink, .quicklink a {font-weight:normal;}\r\n.quicklink a.selected {font-weight:bold;}\r\n\r\n/* ------------------------------------------ */\r\n/*                 Formulieren                */\r\n/* ------------------------------------------ */\r\nfieldset {display:block; width:auto; clear:both; position:relative; margin:0 -1px 0 0; padding:10px 5px 10px 5px; border:0; background:url(../images/stippellijn-blauw.gif) left bottom repeat-x;}\r\nfieldset p {padding-left:10px; line-height:1.5em; width:70%;}\r\nfieldset h3 {position:relative;}\r\nfieldset h3 a {position:absolute; left:185px;}\r\n\r\n/* formField */\r\n.formField {margin:2px 0px 2px 0px; float:left; clear:both; min-height: 1.7em;}\r\n.formField label {display:block; float:left; clear:both; width:14.167em; margin-top:1px; padding-left:10px;}\r\n.formField label.required {background:url(../images/verplicht.gif) 0 3px no-repeat;}\r\n.formField img {margin:0 0 0 1px; padding:0; cursor:pointer; width:auto; vertical-align:bottom; }\r\n.formField input {float:left; margin-left:6px;}\r\n.formField select {float:left; margin:0 0 0 6px; clear:none; padding:0;}\r\n.formField textarea {float:left; clear:none; margin-left:6px;}\r\n.formField span {float:left; margin:1px 2px 0 5px;}\r\n.formField span input {float:left;}\r\n.formField label.postFix {width:auto; display:block; float:left; clear:right; position:relative; top:3px; margin:0 5px 0 5px;}\r\n.formField label.widthPerifeerKantoorPostfix {width:38%;} /* #4702 */\r\n.formField div.postFix {position:relative; top:3px; float:left; margin-top:0px; margin-left:5px;}\r\n.formField h4 {padding-left:15px;}\r\n.formField p {padding-left:15px;}\r\n.formField span.leeftijd {position:relative; top:0;}\r\n.formField a {margin-left:10px;}\r\n.formField span.lovPanel {margin:0 0 0 0;}\r\n.formField .input.radiobuttons input, .formField .input.checkboxes input,\r\n.formField .input.radiobuttons.long input, .formField .input.checkboxes.long input {margin:0px 5px 0px 5px;}\r\n\r\n/* formField op volle breedte van het formulier, alles onder elkaar zetten binnen het formField */\r\n.formField.fullwidth {width:100%; margin-right:-10px;}\r\n.formField.fullwidth label {display:block; clear:both; margin:5px 0 5px 0; width:auto; padding-bottom:0px;}\r\n.formField.fullwidth textarea {display:block; clear:both; margin:2px 0 0 5px;}\r\n.formField.fullwidth select {display:block; clear:both; margin:2px 0 0 5px;}\r\n.formField.fullwidth input {display:block; clear:both;  margin:2px 0 0 5px;}\r\n.formField.fullwidth .radiobuttons input, .formField.fullwidth .checkboxes input {margin:0px 5px 0px 0px;}\r\n.formField.fullwidth .postFix {display:block; float:left; clear:both; margin-left:5px; width:80%;}\r\n\r\n.formField.extendedwidth {font-weight: 600; width:100%; margin-right:-10px; padding-left: 10px; margin-top: 1px;  display: block;}\r\n.formField a.informatieIconI {margin-left: 0px;}\r\n\r\n\r\n/* zoekveld met label, inputveld en button op 1 rij */\r\n.searchField {position:relative; float:left; margin:0 0 2px 0; padding:0 0 0 0; height:1%;}\r\n.searchField label {display:block; float:left; width:170px; margin-top:3px; padding-left:0;}\r\n.searchField .error {margin-left:180px;}\r\n.searchField input {float:left; margin-left:15px;}\r\n.searchField img {margin:0 0 0 1px; padding:0; cursor:pointer; width:auto; vertical-align:bottom;}\r\n\r\n/* input */\r\ninput, textarea, select {padding:2px; border:1px solid #7f9db9; font-family:Open Sans, Arial, Helvetica, sans-serif; font-size:1em; color:#001b4d;}\r\ninput {padding:1px 2px 2px 2px;}\r\ninput.lovinputfield {height:auto; margin-bottom:2px;}\r\ninput.disabled, input.readonly, select.readonly, textarea.readonly {background-color:#fff; color:#555; font-weight:normal; border:1px solid #ccc;}\r\ninput[disabled] {background-color:#fff; color:#555;}\r\ntextarea[disabled] {background-color:#fff; color:#555;}\r\ninput.noborder {border:none;}\r\ninput[type=\"checkbox\"] {border:0; margin-right: 3px;}\r\ninput[type=\"radio\"] {border:0; margin-right: 5px;}\r\ntextarea {margin:0;}\r\nselect {width:auto;}\r\ninput.money {text-align:right;}\r\n\r\n.formField .postFix-counter, .formField.fullwidth .postFix-counter {float:left; clear:both; text-align:left;}\r\n.formField .postFix-counter {margin-left:0px;}\r\n.formField .postFix-counter span.counter {padding-left:190px;}\r\n.formField.fullwidth .postFix-counter {margin-left:5px;}\r\n.formField.fullwidth .postFix-counter span.counter {padding-left:5px;}\r\n.postFix-counter span.counter {padding:0; color:#666; width:auto; clear:none; font-size:80%; display:inline-block}\r\n\r\n/* table voor input, o.a. radiobuttons en checkboxes */\r\ntable.input {float:left; clear:right; position:relative; top:3px;}\r\ntable.input th {background-color:#fff; background-image:none; color:#001b4d; border-bottom:1px solid #001b4d; font-weight:bold;}\r\ntable.input tr {background:none;}\r\ntable.input td {padding:0;}\r\ntable.input input {margin-left:0; clear:none;}\r\ntable.input label {clear:none; width:auto; margin-right:10px; padding-left:0; position:relative; top:-2px;}\r\ntable.input textarea {margin-left:2em;}\r\ntable.input textarea.required {border:1px solid red}\r\ntable.input td a.icon {margin-left:8px;}\r\n\r\ntable.input.radiobuttons td, table.input.checkboxes td {width:17em;}\r\ntable.input.radiobuttons.long td {width:auto;}\r\ntable.input.checkboxes.long td {width:auto;}\r\ntable.input.checkboxes.long td.checkboxRubriek {width:12px;margin-left:0px;}\r\ntable.input.checkboxes.long td.rubriekBox {width:12px;}\r\ntable.input.checkboxes.long td.rubriekInfo {width:40px;}\r\ntable.input.checkboxes.long td.rubriekNr {width:45px;text-align:left;}\r\ntable.input.checkboxes.long td.rubriekOms {width:500px;text-align:left;}\r\ntable.input.checkboxes.long td.rubriekStdtekst {width:15%;text-align:left;}\r\ntable.input.radiobuttons td span, table.input.checkboxes td span  {margin-top:0; margin-left:21px;}\r\ntable.input.long td a.icon {margin-left:0;}\r\ntable.notitie {margin-left: 15px;}\r\n\r\ntable.input.inputvelden {margin:0 0 -4px 2px; position:relative; top:0px;}\r\ntable.input.inputvelden td {padding:2px; vertical-align:top;}\r\ntable.input.inputvelden td span {margin-left:0px;}\r\ntable.input.inputvelden td div.postFix {margin-top:3px; top:0;}\r\ntable.input.inputvelden label {top:0; padding-left:10px;}\r\n\r\n.formField table.input {margin-left:4px;}\r\n.formField table.input.longlines {width:1420px; margin-left:0px;}\r\n\r\n.formField .input.inputvelden td span.postFix {margin-left:3px;}\r\n.formField.fullwidth table, .formField.fullwidth table.input  {clear:both; width:80%; margin-left:5px; margin-bottom:5px;}\r\n.formField.fullwidth table.input input, .formField.fullwidth table.input label {clear:none; float:left;}\r\n.formField.fullwidth table.input.inputvelden {clear:both; margin-left:0; border-collapse:separate;}\r\n.formField.fullwidth table.input.radiobuttons.long,\r\n.formField.fullwidth table.input.checkboxes.long {width:100%;}\r\n.formField.fullwidth table.input.inputvelden.long td .postFix {width:auto; clear:none;}\r\n\r\n/*VA beoordelingsgegevens tabblad */\r\n#beoordelingGegevensPage\\:typeBeoordeling {margin-bottom:0.7em;}\r\n#beoordelingGegevensPage\\:beoordelingConclusie {margin-bottom:0.7em;}\r\n#beoordelingGegevensPage\\:beoordelingToelichting {margin-bottom:0.7em;}\r\n#beoordelingGegevensPage\\:duurzaam {margin-bottom:0.7em;}\r\n\r\n/*\r\n#beoordelingGegevensPage\\:duurzaamFieldLabel {display: none;}\r\n*/\r\n\r\n/* ADA Rapporten print pagina */\r\n.rapport {width:500px; position:relative; float:left;}\r\n.rapport-details {width:auto; position:relative; float:left;}\r\n.rapport-details .formField span.error {display:block; width:100%; float:left; margin-bottom:4px;}\r\n\r\n/* BUTTONS */\r\nform .buttons {width:100%; clear:both;}\r\nform fieldset .buttons {padding-left:175px; padding:0px 5px 0px 0px;}\r\nfieldset .buttons {display:block; clear:both; direction:rtl; float:left; position:relative; margin:5px 0 5px 5px;}\r\n.buttons {height:1%; clear:both; direction:rtl; float:left; position:relative; margin:1em 0 0.5em 0;}\r\n.buttons h4 {padding-left:0;}\r\n.button {margin:0px 5px 0 0; padding:1px 4px 0px 4px; overflow:visible; direction:ltr; color:#001b4d; background-color:#fff; cursor:pointer;}\r\n.formField .button {margin-top:0; }\r\nform .buttons .button.searchbutton {margin-left:45px;}\r\nform fieldset .buttons .button.searchbutton {}\r\nform fieldset .buttons .button.annul {margin-left:-5px;}\r\n.buttons .button {}\r\n.buttons .button.zoekbutton {margin:0 0 0 5px; padding:0px 4px 0px 4px; border:1px solid #001b4d; background-color:#fff;}\r\n.buttons .button.zoekbutton:hover{-webkit-box-shadow: inset 1px 1px 17px -4px rgba(0,27,77,1); -moz-box-shadow: inset 1px 1px 17px -4px rgba(0,27,77,1); box-shadow: inset 1px 1px 17px -4px rgba(0,27,77,1);}\r\n.button.zoekbutton {margin:0 0 0 5px; padding:4px 10px 4px 10px; background-color:#0078D2; position:relative; top:-2px; border-radius: 5px; color:#FFFFFF;}\r\n.button.lovzoekbutton {margin: 0 0 0 5px; padding: 4px 10px 4px 10px; background-color: #0078D2; position: relative; top: 0px; border-radius: 5px; color: #FFFFFF;}\r\n.buttons .button.blokkeer {border:1px solid #f00; color:#f00;}\r\n.buttons .button.verwijder {border:1px solid #f00; color:#f00; background-image:none;}\r\n.buttons .button.deblokkeer {border:1px solid #090; color:#090;}\r\n.button.right {float:right;}\r\n.buttons.marginleft {margin-left:1em;}\r\n.buttonpopup {float:left; position:relative; clear:both; margin:10px 5px 0px 0px;}\r\n\r\nform .functiebelasting-details .buttons {width:auto; margin:5px 0 0 5px;}\r\nform .functiebelasting-details .buttons .button {margin:0 0 5px 1px;}\r\nform .loonelementen-details .buttons {width:auto; margin:5px 0 0 5px;}\r\nform .loonelementen-details .buttons .button {margin:0 0 5px 1px;}\r\n\r\n/* ERROR */\r\n.errorNoSpan {color:#f00; margin-bottom:0px;}\r\n.error {color:#f00;}\r\n.error span, label.error {color:#f00; margin-bottom:4px; float:left;}\r\nspan.error {color:#bf1919; margin-bottom:4px; float:none;}\r\n.formField div.error {display:block; clear:both; margin-left:185px; margin-bottom:4px;}\r\n.formField div.error span {margin-left:0; clear:none;}\r\n.formField div.error2 {display:block; margin-left:180px; }\r\n.formField div.error2 span {color:#f00; margin-bottom:4px;}\r\n.formField div.errorBP31 {display:block; margin-left:0px; }\r\n.formField div.errorBP31 span {color:#f00; margin-bottom:4px;}\r\n.formField span.error {display:block; margin:0; padding-left:185px; padding-bottom:0; margin-bottom:4px;}\r\n.formField div span.error {margin-bottom:4px;}\r\n.formField.fullwidth div.error, .formField.fullwidth div.error span, .formField.fullwidth span.error {margin:0; padding:0 0 0 10px; clear:both;}\r\nform div.error ul li {padding-left:5px;}\r\nform fieldset div.error ul li {padding-left:0px;}\r\ndiv.error ul li {margin-left:-40px;}\r\n.tabcontent ul li.error, fieldset ul li.error {list-style:none; margin-left:-25px; padding-top:5px;}\r\nfieldset ul.error li {list-style:none; margin-left:-30px; padding-top:5px;}\r\n\r\n/* error op input */\r\ninput.error, select.error, textarea.error {clear:none; margin:0px 0px 0px 5px; border-color:#f00; color:#001b4d;}\r\ntable.radiobuttons.error, table.checkboxes.error {border:1px solid #f00; color:#001b4d;}\r\n.input.radiobuttons span.error {display:block; margin-left:2em;}\r\n.error ul {margin:0.2em 0 0.5em 0.8em; list-style-type:none;}\r\n/*speciale error voor de vraag van het schonen van de voorselectie*/\r\nfieldset p.error {margin-left:-5px; padding:0; width:auto;}\r\n/*speciale error voor percentage bij taken niet ingevuld */\r\n.formField span.taak-error {position:relative; display:block; float:none; width:auto; color:#f00; margin:0; padding-left:31px}\r\nspan.percentage-error {padding-left:0; color:#f00;}\r\n\r\n\r\n/* ERRORPAGE */\r\n.errorpage {margin-left:200px; width:500px; margin-top:20px;}\r\n.errorpage h1 {font-size:1.2em;}\r\n.errorpage p {padding:0.2em 0 0.2em 0;}\r\n.errorpage ul {margin:0.5em 0 0.7em 1.3em;}\r\n.errorpage ul li {padding:0.3em 0 0.3em 0;}\r\n\r\n/* ------------------------------------------ */\r\n/*                 Tabellen                   */\r\n/* ------------------------------------------ */\r\n/* sortering */\r\n.sort span {padding-right:10px; background:url(../images/sort-none-wit.gif) right 1px no-repeat;}\r\n.sort.none span a {text-decoration:underline;}\r\n.sort.up span {padding-right:10px; background:url(../images/sort-za-wit.gif) right 1px no-repeat;}\r\n.sort.down span {padding-right:10px; background:url(../images/sort-az-wit.gif) right 2px no-repeat}\r\n\r\ntable, tr, th, td {margin:0; padding:0; border:0; border-spacing:0; border-collapse:collapse; text-align:left; font-size:1em;}\r\ntable {caption-side:top; }\r\ncaption {margin:0; padding:5px 0 5px 5px; text-align:left; color:#001b4d; font-size:1.1em; font-weight:bold;}\r\nthead th {margin:0; font-weight:bold; color:#fff; background:#001b4d url(../images/verloop-blauw.gif) left top repeat-x;}\r\nthead.lightheader th {color:#001b4d; background:#deeef9}\r\nthead tr.navigeer th, tfoot tr.navigeer td {background-color:#fff; background-image:none;}\r\nthead tr.navigeer th, tfoot tr.navigeer td, .navigeer a {color:#001b4d; font-weight:normal;}\r\nth {white-space:nowrap;}\r\ntfoot td {padding:5px;}\r\ntbody tr {background:url(../images/stippellijn-blauw.gif) left bottom repeat-x;}\r\ntbody tr.infoLogin {background:none;}\r\ntbody tr.parent td {background-color:#eff6fc;}\r\ntbody tr.child td {background-color:#fff;}\r\ntbody tr.kop td, thead tr.kop th{font-weight:bold; color:#001b4d; background-color:#deeef9; background-image:none;}\r\ntd {padding:2px 5px 2px 4px; vertical-align:top;}\r\n.resultaat td {padding:2px 10px 2px 4px; vertical-align:top;}\r\nth.fixWidth {width:60px;}\r\n\r\ntd table td {padding-left:0; }\r\nthead td, tfoot td {border:0; text-align:center; background-color:#fff; text-align:left;}\r\ntable.noborder, table.noborder tr, table.noborder tr td {border:0; background:none; margin:0; padding-left:0;}\r\ntd.smallrow {height:5px;}\r\ntr.editmode {background-color:#e5f0b4;}\r\n\r\n/*** TE BEHOUDEN CLASSES ----> ***/\r\n/* Startpagina */\r\n.startpagina .col1 {width:8em;} /*bsn*/\r\n.startpagina .col2 {width:30em;} /*achternaam*/\r\n.startpagina .col3 {width:15em;} /*geldig vanaf*/\r\n.startpagina .col4 {width:12em;} /*vastgelegd*/\r\n.startpagina .col5 {width:20em;} /*AO crit, erg lang ivm wajong*/\r\n.startpagina .col6 {width:auto;} /*vr/antw OF icons*/\r\n.startpagina .col7 {width:auto;} /*icons*/\r\n\r\n/* beoordelingspunten; lijst die VA moet invullen */\r\n.waarde {width:100%;}\r\n.waarde .col1 {width:2%;}\r\n.waarde .col2 {width:2%;}\r\n.waarde .col3 {width:2%;}\r\n.waarde .col4 {width:2%;}\r\n.waarde .col5 {width:80%;}\r\n.waarde .col1, .waarde .col2, .waarde .col3, .waarde .col4, .waarde .col5 {padding:0;}\r\ntr.selected td {font-weight:bold;}\r\n.waarde tr.child td {background-color:#fff;}\r\n.waarde tr.child div {margin-top:0.1em; margin-bottom:0.5em;}\r\n.waarde tr.child div table.input {float:none; margin-left:2px;top:1px;}\r\n.waarde tr.child div table.input textarea {margin:0 0 0 2px;}\r\n.waarde tr.child div table.input.radiobuttons.long label {float:none;}\r\n.waarde tr.child div table.input.checkboxes.long label {float:none; margin-left:2px}\r\n\r\n/* functie: header */\r\n.functieHeaderLeft {clear: left; float:left; width:55%}\r\n.functieHeaderRight {float:right; width:45%}\r\n\r\n/* functie: functiebelasting */\r\n.functiebelasting {width:500px; padding:0; margin:0;}\r\nform div.floatleft.border.loonelementen-details {width:580px; padding-right:-10px;}\r\nform div.floatleft.border.loonelementen-details fieldset .formField div.postFix {top: 2px; padding-left:5px;}\r\n.loonelementen {width:510px; padding:0; margin:0;}\r\n.functiebelasting-details, .loonelementen-details {float:left; position:relative;}\r\nform div.floatleft.border.functiebelasting-details h2.kop,\r\nform div.floatleft.border.loonelementen-details h2.kop  {position:relative; width:auto; margin:0; padding:5px; font-weight:bold; text-decoration:none; color:#fff; background:#001b4d url(../images/verloop-blauw.gif) left top repeat-x;}\r\nform div.floatleft.border.loonelementen-details h4 {margin:0 0 5px 5px;}\r\nform div.floatleft.border.functiebelasting-details .formField span.omschrijving {padding:0; width:70%; float:left; display:inline; position:relative;}\r\nform div.floatleft.border.functiebelasting-details fieldset .formField {width:100%;}\r\nform div.floatleft.border.functiebelasting-details fieldset .formField label {clear:none; position:relative;}\r\nform div.floatleft.border.functiebelasting-details fieldset .formField span {float:none; margin:0; display:block;}\r\nform div.floatleft.border.functiebelasting-details fieldset .formField.fullwidth {width:95%;}\r\nform div.floatleft.border.functiebelasting-details tr.editmode {background-color:#e5f0b4;}\r\nspan.omschrijving {width:610px;}\r\n\r\n.functiebelasting-details th span.required,\r\n.loonelementen-details th span.required {padding-left:10px; background:url(../images/verplicht.gif) 0 3px no-repeat; float:left;}\r\n.loonelementen-details table th.col_uren {width:100px;}\r\n.loonelementen-details table th.col_periode {width:300px;}\r\n.loonelementen-details table th.col_perc {width:100px;}\r\n\r\n.functiebelasting-details input, .loonelementen-details input {padding:2px;}\r\n.functiebelasting-details select, .loonelementen-details select {margin-top:1px;}\r\n\r\n.functiebelasting-details fieldset .formField.fullwidth table.input.radiobuttons.long td label input,\r\n.functiebelasting-details fieldset .formField.fullwidth table.input.checkboxes.long td label input {margin:0 10px 20px 2px;}\r\n\r\n.functiebelasting-details .buttons {margin:5px 0 5px 5px;}\r\n.functiebelasting-details .buttons .button {margin:0;}\r\n.loonelementen-details .buttons {margin:5px 0 5px 5px;}\r\n.loonelementen-details .buttons .button {margin:0;}\r\n.loonelementen-details .buttons .verwijderloonelementbutton {float:right; position:relative; top:-23px; margin-right:5px; margin-bottom:-23px; height:23px;}\r\n\r\n.loonelementen-toelichting h3 {padding: 0.2em 0 0.2em 0.6em;font-size: 85%;font-weight: bold;}\r\n.loonelementen-toelichting p {padding: 0.2em 0 0.2em 0.6em;font-size: 85%;}\r\n\r\n.functiebelasting-details ul li.error {list-style:none; margin:0 0 0 -25px; }\r\nform div.floatleft.border.functiebelasting-details-fixedsize {position:relative; width:840px;}\r\nform div.floatleft.border.functiebelasting-details-fixedsize table.input label {width:720px;}\r\nform div.floatleft.border.functiebelasting-details-fixedsize .formField textarea {width:765px;}\r\nform div.floatleft.border.loonelementen-details-fixedsize {position:relative; width:675px;}\r\nform div.floatleft.border.loonelementen-details-fixedsize .formField textarea {width:469px;}\r\n\r\n/* Voorselectie */\r\n.voorselectie .col1 {width:25%;}\r\n.voorselectie .col2 {width:35%;}\r\n.voorselectie .col3 {width:20%;}\r\n.voorselectie .col4 {width:20%;}\r\n\r\n/* voorkeur voorselectie */\r\n.dr-table th.subkop {background:#fff url(../images/verloop-lichtblauw.gif) left bottom repeat-x; color:#001b4d; font-weight:normal;}\r\n.dr-table th.subkop a {font-weight:normal; color:#009ad7;}\r\n.dr-table tbody tr {background:none;}\r\n.dr-table tbody tr td {background-image:url(../images/stippellijn-blauw.gif); background-position:left bottom; background-repeat:repeat-x;}\r\n.dr-table tr.child table tr {background:none; border-bottom:0;}\r\n.dr-table tr.child table tr td {background-image:none;}\r\n.dr-table tr.noborder td {background:none; border-bottom:0;}\r\n.dr-table table.input tr td {background:none; border-bottom:0;}\r\n\r\n/* Eindselecteren */\r\n.selectieproces {width:100%;}\r\n.selectieproces thead th.lightheader {background:#d7dfe7 url(../images/verloop-lichtblauw.gif) left top repeat-x; color:#001b4d; font-weight:normal;}\r\n.selectieproces thead th.lightheader-uwvblue {background:#b9cef7; color:#001b4d; font-weight:normal;}\r\n.selectieproces thead th.lightheader a {color:#001b4d; font-weight:normal; text-decoration:underline;}\r\n.selectieproces thead th.lightheader-uwvblue a {color:#001b4d; font-weight:normal; text-decoration:underline;}\r\n.selectieproces thead th.lightheader a:hover {color:#009ad7;}\r\n.selectieproces thead th.lightheader-uwvblue a:hover {color:#0d6e98;}\r\n.selectieproces thead th span, .selectieproces thead th a {clear:none; float:left;}\r\n.selectieproces tfoot td.lightheader {padding: 13px 2px 13px 10px; background:#d7dfe7 url(../images/verloop-lichtblauw.gif) left top repeat-x; color:#001b4d; font-weight:normal;}\r\n.selectieproces tfoot td.lightheader-uwvblue {padding: 13px 2px 13px 10px; background:#b9cef7; color:#001b4d; font-weight:normal;}\r\n.selectieproces tfoot td.lightheader a {color:#001b4d; font-weight:normal; text-decoration:underline;}\r\n.selectieproces tfoot td.lightheader-uwvblue a {color:#001b4d; font-weight:normal; text-decoration:underline;}\r\n.selectieproces tfoot td.lightheader a:hover {color:#009ad7;}\r\n.selectieproces tfoot td.lightheader-uwvblue a:hover {color:#0d6e98;}\r\n.selectieproces tfoot td span, .selectieproces tfoot td a {clear:none; float:left;}\r\n.selectieproces tbody tr td .selectieproces tbody tr td {background:url(../images/stippellijn-blauw.gif) left bottom repeat-x;}\r\n.selectieproces thead th.col1, .selectieproces tbody td.col1 {width:5%;}\r\n.selectieproces thead th.col2, .selectieproces tbody td.col2 {width:75%;}\r\n.selectieproces thead th.col3, .selectieproces tbody td.col3 {width:10%;}\r\n.selectieproces thead th.col4, .selectieproces tbody td.col4 {width:10%;}\r\n.selectieproces table.functiedetails {width:100%;}\r\n.selectieproces table.functiedetails td.col1 {width:11%; font-style:italic;}\r\n.selectieproces table.functiedetails td.col2 {width:auto;}\r\n.selectieproces table.functiedetails td.col3 {width:15%; font-style:italic;}\r\n.selectieproces table.functiedetails td.col4 {width:10%;}\r\n.selectieproces table.functiedetails td.col5 {width:30%;}\r\n.selectieproces table.functiedetails td.col6 {width:10%;}\r\n.selectieproces table.functiedetails.noborder tr td {background:none;}\r\n.selectieproces table.functiedetails td.col3 div.icons {position:relative; top:23px; z-index:2001;}\r\n.selectieproces table.functiedetails td.col3 textarea {}\r\n.selectieproces table.functiedetails td.col3 div.postFix-counter {display:inline; position:relative; left:8px; line-height:20px; z-index:2000;}\r\n.selectieproces .rich-datascr .rich-dtascroller-table td {background:none;}\r\n\r\n/* oude IE8 hacks */\r\n.rich-mpnl-controls {position:absolute; top:12px; right:11px;}\r\n.rich-mpnl-ovf-hd.rich-mpnl-trim.rich-mpnl-content {padding-bottom:20px}\r\ntr.bg-highlight>td {background-color:#deeef9;}\r\nthead .rich-datascr {margin-bottom:2px;}\r\na.arrowleft.icon {height:auto;}\r\n.jscalendar-DB-div-style .jscalendar-DB-table-style .jscalendar-DB-selected-day-style td a:hover {font-weight:bold;}\r\n\r\n/*tussenresultaat eindselectie = winkelmandje*/\r\n/*.winkelmandje {width:!*100%*!270px; margin-left:1!*%*!px; clear:both; float:left; color:#001b4d;}*/\r\n.winkelmandje {width:270px; margin-left:1px; clear:both; float:left; color:#001b4d;}\r\n.winkelmandje thead th {#001b4d url(../images/verloop-blauw.gif) left top repeat-x;}\r\n.winkelmandje tbody th {background:none; background-color: #b9cef7; color:#001b4d; padding:3px 5px 3px 5px;}\r\n.winkelmandje td {padding:5px 5px 5px 5px; vertical-align:middle;}\r\n.winkelmandje tbody tr {}\r\n.winkelmandje tr.kop td {background-color:#fff; color:#060; background:url(../images/stippellijn-groen.gif) left bottom repeat-x;}\r\n.winkelmandje td.oranje {background-color: #ff9900; cursor:pointer;}\r\n.winkelmandje td.groen {background-color: #9dcd00; cursor:pointer;}\r\n\r\n/* Signaleren */\r\n.signaleren {width:100%;}\r\n.signaleren tr.kop td{font-weight:bold; background-color:#eff6fc;}\r\n.signaleren td {background:none;}\r\n.signaleren td.col1 {width:14%}\r\n.signaleren td.col2 {}\r\n.signaleren td table {width:100%;}\r\n.signaleren td table td.col1 {width:50%;}\r\n.signaleren .input input {margin-top:-4px;}\r\n.signaleren .input label {padding-top:1px;}\r\n/* resultaat */\r\n.resultaat {width:100%;}\r\n.resultaat tr{background:none;}\r\n\r\n/* vragen en antwoorden */\r\n.vrg_antw {width:100%;}\r\n.vrg_antw td {text-align:left;}\r\n\r\n/* beheer */\r\n.parameters .col1 {width:10%;}\r\n.parameters .col2 {width:10%;}\r\n.sbcHead {padding-left:10px;}\r\n.sbcHead0 {padding-left:0px;}\r\n.sbcEditCol1 {width:14.67em; padding:5px 0px 0px 10px;}\r\n.sbcEditCol2 {Width:auto; padding:5px 5px 7px 0px;  }\r\n.sbcEditCol3 {Width:auto; padding:5px 5px 7px 0px;}\r\n.sbcEditCol4 {Width:auto; padding:5px 5px 7px 0px;}\r\n.sbcViewCol1 {width:14.67em; padding:5px 0px 0px 10px;}\r\n.sbcViewCol2 {Width:auto; padding:5px 5px 7px 0px;}\r\n.sbcViewCol3 {Width:auto; padding:5px 5px 7px 0px;}\r\n\r\n/* ADA Actualiseren functies */\r\n.actualiseren .col1 {width:10%;} /* checkbox */\r\n.actualiseren .col2 {width:10%;} /* functienummer */\r\n.actualiseren .col3 {width:38%;} /* functienaam */\r\n.actualiseren .col4 {width:10%;} /* arbeidsplaatsen */\r\n.actualiseren .col5 {width:5%;} /* regio */\r\n.actualiseren .col6 {width:15%;} /* pk */\r\n.actualiseren .col7 {width:10%;} /* sbc code */\r\n.actualiseren .col8 {width:2%;} /* icons */\r\n.actualiseren td {vertical-align:middle;}\r\n\r\n/* Medisch dossier: beoordelingsgegevens: cascodes */\r\ntable.cascodes td.error {padding:0px;}\r\n.cascodes .col1 {width:2em;} /* Code Oorzaak */\r\n.cascodes .col2 {width:10em;} /* Diagnose code */\r\n\r\n/* ------------------------------------------ */\r\n/*           ALL   HOVER                      */\r\n/* ------------------------------------------ */\r\ntable.hovertable tbody tr.hovertablerow td {background-color:#deeef9;}\r\ntable.hovertable.waarde tbody tr.parent.hoverparentrow td {background-color:#deeef9; cursor:pointer;}\r\ntable.hovertable.waarde tbody tr.child.hoverchildrow td {background-color:#fff;}\r\n\r\n\r\n\r\n\r\n/* .buttons input.ie6hover.button.volgende.hovervolgendebutton {background-color:#deeef9;} */\r\n\r\n.buttons input.ie6hover.button.vorige.hovervorigebutton {}\r\n.buttons input.ie6hover.button.opslaan.hoveropslaanbutton {background-color:#deeef9;}\r\n.buttons input.ie6hover.button.verwijder.hoververwijderbutton {background-color:#f00; color:#fff;}\r\n.buttons input.ie6hover.button.blokeer.hoverblokkeerbutton {background-color:#FFD9D9;}\r\n.buttons input.ie6hover.button.deblokkeer.hoverdeblokkeerbutton {background-color:#e8efb2;}\r\ninput.ie6hover.button.zoekbutton.hoverzoekbutton {background-color:#deeef9;}\r\n\r\n/* ------------------------------------------ */\r\n/*                 Icons                      */\r\n/* ------------------------------------------ */\r\nth.icons {width:180px;}\r\ndiv.icons {float:right;}\r\ndiv.icons.fixed8x {width:200px;} /* 8 buttons */\r\ndiv.icons.fixed6x {width:150px;} /* 6 buttons */\r\ndiv.icons.fixed2x {width:60px;}  /* 2 buttons */\r\ntable.icons {z-index:1; float:right; padding:0; margin:0;}\r\ntable.icons tr, table.icons tr td {background-image:none;}\r\ntable.icons tbody tr td {width:20px; text-align:left; padding:0; background-color:transparent;}\r\n\r\n.formField .icon, fieldset .icon {margin-top:3px;}\r\n\r\n.icon {display:block; clear:none; float:left; height:20px; width:auto; cursor:pointer; margin:0; padding-left:20px; text-decoration:none;}\r\ndiv.icons a.icon {display:inline; height:25px; width:22px; cursor:pointer; margin:0; padding-left:0; text-decoration:none;}\r\ndiv.icons span.noicon {width:25px; height: 14px; clear:none; float:left; margin:0px; padding:0px; display:block;}\r\n.icon span, td span.icon span {display:none;}\r\n\r\n.icon.inzien {background:transparent url(../images/iconsIE8/ico_inzien.gif) no-repeat; }\r\n.icon.edit {background:url(../images/iconsIE8/ico_edit.gif) no-repeat;  }\r\n.icon.kopie {background:transparent url(../images/iconsIE8/ico_kopie.gif) no-repeat;  }\r\n.icon.print {background:url(../images/iconsIE8/ico_print.gif) no-repeat;  }\r\n.icon.antwoord {background:url(../images/iconsIE8/ico_antwoord.gif) no-repeat; }\r\n.icon.vraag {background:url(../images/iconsIE8/ico_vraag.gif) no-repeat; }\r\n.icon.vragenAanpassen {background:url(../images/iconsIE8/ico_vraagmetkruis.gif) no-repeat; }\r\n.icon.vraag.label {clear:both;}\r\n.icon.nieuw {background:transparent url(../images/iconsIE8/ico_nieuw.gif) no-repeat; height:18px; }\r\n.icon.verwijder {background:transparent url(../images/iconsIE8/ico_verwijder.gif) no-repeat; }\r\n\r\n.icon.foutief {background:transparent url(../images/iconsIE8/ico_foutief.gif) no-repeat; }\r\n.icon.blokkade {background:transparent url(../images/iconsIE8/ico_blokkade.gif) no-repeat; cursor:default;}\r\n.icon.vrij {background:transparent url(../images/iconsIE8/ico_checked.gif) no-repeat; }\r\n.icon.checked {background:transparent url(../images/iconsIE8/ico_checked.gif) no-repeat; cursor:default; width:10px; margin-top:3px;}\r\n.icon.akkoord {background:transparent url(../images/iconsIE8/vrij.gif) no-repeat; }\r\n.icon.info {height:16px; background:transparent url(../images/icons/ico_info.gif) no-repeat;  }\r\n.icon.pdf {background:transparent url(../images/iconsIE8/ico_pdf.gif) no-repeat; width:23px!important; height:24px!important;}\r\n.icon.signaal {height:25px; background:transparent url(../images/iconsIE8/signalering.gif) no-repeat; width:98px; padding-left:10px; margin-bottom:0.2em;}\r\n.icon.signaalGezien {height:25px; background:transparent url(../images/iconsIE8/signalering_gezien.gif) no-repeat; width:98px; padding-left:10px; margin-bottom:0.2em;}\r\n.icon.geensignaal1 {height:25px; background:transparent url(../images/iconsIE8/geen_signalering.gif) no-repeat; width:98px; padding-left:10px; margin-bottom:0.2em;}\r\n.icon.vraagstellen {height:25px; background:transparent url(../images/iconsIE8/vraag.gif) no-repeat; width:60px; margin-left:5px; margin-bottom:0.2em; }\r\n.icon.geensignaal2 {height:25px; background:transparent url(../images/iconsIE8/geen_signalering_gezien.gif) no-repeat; width:98px; padding-left:10px; margin-bottom:0.2em;}\r\n.icon.functiekader {height:25px; background:transparent url(../images/iconsIE8/functiekader.png) no-repeat; width:115px; padding-left:10px; margin-bottom:0.2em; margin-left: 35px}\r\n.icon.duurzaamheid {background:url(../images/iconsIE8/ico_duurzaamheid.gif) no-repeat;}\r\n.icon.duurzaamheidAanpassen {background:url(../images/iconsIE8/ico_duurzaamheidmetkruis.gif) no-repeat;}\r\n.icon.voorkeur {float:none; display:inline; background:transparent url(../images/icons/ico_voorkeur.gif) no-repeat;}\r\n.icon.person {background:transparent url(../images/iconsIE8/ico_add_person.gif) no-repeat;}\r\n.icon.omzetten {background:transparent url(../images/iconsIE8/ico_change_person.gif) no-repeat;}\r\n.icon.ververs {background:transparent url(../images/iconsIE8/ico_user_ververs.gif) no-repeat;}\r\n.icon.zoek {height:20px; background:transparent url(../images/icons/ico_zoek.gif) 0 0 no-repeat; margin-top:1px; margin-left:5px;}\r\n.icon.close {background:transparent url(../images/icons/ico_sluiten.gif) top right no-repeat; float:right; }\r\n.icon.arrowleft {background:transparent url(../images/icons/ico_arrowleft.gif) top left no-repeat; margin:0;}\r\n.icon.arrowleft.rubriekStdtekst {text-align:left;}\r\n.icon.omlaag {background:transparent url(../images/icons/ico_arrowdown.gif) top left no-repeat; }\r\n.icon.omhoog {background:transparent url(../images/icons/ico_arrowup.gif) top left no-repeat; }\r\n.iconInfo {margin-top:1px;margin-bottom:2px;}\r\n/* To be able to hide the icons above, specify hidden/hide class */\r\ndiv.icons a.icon.hidden, div.icons a.icon.hide {display:none;}\r\n\r\n/* ------------------------------------------ */\r\n/*                 ZoekPopUp                  */\r\n/* ------------------------------------------ */\r\n.zoekpopup {width:400px; border:1px solid #001b4d;}\r\n.zoekpopup-header {line-height:20px; background:#001b4d none; color:#fff;}\r\n.zoekpopup-subheader {line-height:20px; background:#009ad7 none; color:#fff;}\r\n.zoekpopup-result {background-color:#fff; margin:0; padding:0;}\r\n.overflow {height:140px; overflow:auto;}\r\n.overflow table {width:383px;}\r\n.overflow table td {padding-left:3px;}\r\n.overflow table td.result-cell-1 {width:50px;}\r\n.overflow table td.result-cell-2 {width:333px;}\r\n\r\n/* ------------------------------------------ */\r\n/*                 Informatie at Login        */\r\n/* ------------------------------------------ */\r\n\r\n/* ------------------------------------------ */\r\n/*                 HelpLayer                  */\r\n/* ------------------------------------------ */\r\na.info {float:left; background-image:url(../images/icons/ico_info.gif) top left no-repeat;}\r\n.helpLayer {border:1px solid #969500; background-color:#e8efb2; padding:0.5em; margin:0em 0em 0.5em 0em; width:80%;}\r\n.helpLayer h2 {font-size:1em; margin:0em 0em 0.5em 0em; clear:none;}\r\n.helpLayer h3 {font-size:1em; margin:0em;}\r\n.helpLayer p {margin:0em 0em 0.2em 0em!important; padding:0em;}\r\n.helpLayer ul {margin:0em 0em 0.5em 0em;}\r\n.helpLayer ul li {margin:0em 0em 0em 1.4em; padding:0em; list-style:disc;}\r\n.helpLayer .icon.sluiten {float:right; background-image:url(../images/icons/ico_sluiten.gif) top left no-repeat;}\r\n\r\n/* data scroller */\r\ndiv.dr-dscr {min-height:22px;}\r\n/* client fieldset */\r\n\r\n/* login */\r\nform.login {margin-left:200px; width:500px; padding:50px 0 0 0;}\r\nform.login .formField {padding:5px; padding-left:0;}\r\nform.login .formField label {padding:0; width:50px;}\r\nform.login fieldset {border:none;}\r\nform.login div.buttons {padding-left:55px;}\r\nform.login .message {color:#f00;}\r\n\r\n/* Footer */\r\n.footer {display:block; width:100%; clear:both; margin-top:0px; border-top:0px solid #666; padding:5px 0px 5px 0px; color:#666; text-align:center;}\r\n.footer a {padding:0 10px 0px 10px; color:#666;}\r\n.footer a:hover {color:#009ad7;}\r\n\r\n#kopieerwijzeForm\\:mbTable td {padding-left:5px;}\r\n#kopieerwijzeForm\\:mbTable input {margin-left:0px;}\r\n\r\n\r\n/* ------------------------------------------ */\r\n/*            aanpassingen UX              \t  */\r\n/* ------------------------------------------ */\r\n\r\n/*header*/\r\n.header {background-color: #D5EEFB;}\r\n\r\n/*menu*/\r\n.nav li.act a{color:#006aca;}\r\n.nav a:link, .nav a:visited, .nav a:active{color:#006aca;}\r\n.classificatie {color:#000C4D; padding-top: 25px; margin-right: 3.3em;}\r\n\r\n/*body*/\r\n.warning p{color:#bf1919; text-align:right; margin: 1em 0 0 1.3em; float:right; width: 60%; font-weight:600;}\r\n\r\n/*tabel*/\r\nthead tr th {padding: 10px 2px 10px 2px;}\r\n\r\n.dr-table {margin: 20px 0 0 0;}\r\n\r\n/*extra padding beoordelingstabel (start)*/\r\n#beoordelingen caption{padding:10px 0 5px 5px;}\r\n\r\n/*extra ruimte tabs klantgegevenspage*/\r\n#klantGegevensPageForm .tabs{padding-top:10px;}\r\n\r\n/*Generieke button styling (secundaire button)*/\r\n.button{margin: 0 0 0 5px; padding: 6px 12px 6px 12px; background-color: #FFFFFF; position: relative; top: 0px; border-radius: 5px; border-color:#0078D2; color:#0078D2;}\r\n.button:hover{background-color: #0058a8; color:#FFFFFF;}\r\n\r\n/*primaire button*/\r\n.primairebutton{\r\n\tmargin: 0 0 0 5px; padding: 6px 12px 6px 12px; background-color: #0078D2; position: relative; top: 0px; border-radius: 5px;color: #FFFFFF; direction:ltr;transition: background-color 0.3s ease;\r\n}\r\n\r\n.primairebutton:hover{\r\n\tbackground-color: #0058a8; color:#FFFFFF; cursor:pointer;\r\n\t-webkit-box-shadow: inset 1px 1px 7px -4px rgba(0,27,77,1);\r\n-moz-box-shadow: inset 1px 1px 7px -4px rgba(0,27,77,1);\r\nbox-shadow: inset 1px 1px 7px -4px rgba(0,27,77,1);\r\n}\r\n\r\n/*\r\n.primairebutton:focus{\r\n\tbackground-color: #0058a8; color:#FFFFFF; cursor:pointer;\r\n\t-webkit-box-shadow: inset 1px 1px 17px -4px rgba(0,27,77,1);\r\n-moz-box-shadow: inset 1px 1px 17px -4px rgba(0,27,77,1);\r\nbox-shadow: inset 1px 1px 17px -4px rgba(0,27,77,1);\r\n}\r\n*/\r\n\r\n/*secundaire button*/\r\n.secundairebutton{\r\n\tmargin: 0 0 0 5px; padding: 6px 12px 6px 12px; background-color: #FFFFFF; position: relative; top: 0px; border-radius: 5px; border-color:#0078D2; color:#0078D2;transition: background-color 0.3s ease;\r\n}\r\n.secundairebutton:hover{\r\n\tbackground-color: #0058a8; color:#FFFFFF; cursor:pointer;\r\n\t-webkit-box-shadow: inset 1px 1px 7px -4px rgba(0,27,77,1);\r\n-moz-box-shadow: inset 1px 1px 7px -4px rgba(0,27,77,1);\r\nbox-shadow: inset 1px 1px 7px -4px rgba(0,27,77,1);\r\n}\r\n.secundairebutton:disabled {\r\n  color:#666;\r\n  background-color:#f0f0f0;\r\n  border-color: #555555;\r\n  pointer-events: none;\r\n}\r\n\r\n/*\r\n.secundairebutton:focus{\r\n\tbackground-color: #0058a8; color:#FFFFFF; cursor:pointer;\r\n\t-webkit-box-shadow: inset 1px 1px 17px -4px rgba(0,27,77,1);\r\n-moz-box-shadow: inset 1px 1px 17px -4px rgba(0,27,77,1);\r\nbox-shadow: inset 1px 1px 17px -4px rgba(0,27,77,1);\r\n}\r\n*/\r\n\r\n#formSbcCodesZoek\\:Search, #formSbiKlassenZoek\\:Search, #werksoortZoek\\:search {\r\n\tmargin: 0 0 0 5px; padding: 6px 12px 6px 12px; background-color: #0078D2; position: relative; top: 0px; border-radius: 5px;color: #FFFFFF; direction:ltr;\r\n}\r\n\r\n#formSbcCodesZoek\\:Search:hover, #formSbiKlassenZoek\\:Search:hover, #werksoortZoek\\:search:hover {\r\n\tbackground-color: #0058a8; color:#FFFFFF; cursor:pointer;\r\n}\r\n\r\n#editVoorselectiePage .floatright {margin-top: -2.1%;}\r\n\r\n/*linkerrij bold */\r\nlabel#klantBsnFieldLabel, label#klantSoortFieldLabel, label#klantVoorlettersFieldLabel, label#klantVoorvoegselFieldLabel, label#klantAchternaamFieldLabel, label#klantTussenvoegselPartnerFieldLabel, label#klantAchternaamPartnerFieldLabel, label#klantGeboorteDatumFieldLabel, label#klantGeboorteDatumFieldLabel, label#klantGeslachtFieldLabel, label#klantSoortFieldLabel{font-weight: 600;}\r\n#klantGegevensPageForm .formfield label{font-weight:600;}\r\n\r\n.status{padding: 3px 0px 22px 0px;}\r\n\r\n/*Counter op functie pages*/\r\n#functieInhoudPage .counter {padding-left:190px;}\r\n#functieTakenPage .counter {padding-left:25px;}\r\n#functieBelastingPage .counter {padding-left:0px;}\r\n\r\n/*Het wijzigen van de positie van de h1 (welkomtekst) op de homepage*/\r\n#h1homepage{top:-10px; margin-bottom:0px;}\r\n\r\n/*Extra ruimte aan de linkerkant bij de meest linker kolom in een tabel ronde hoeken tabel*/\r\n.col7{border-radius: 0px 5px 0px 0px;}\r\n#arbeidVoorselectieTabcontent .col4 {border-radius: 0px 5px 0px 0px;}\r\n#report .child td{padding:3px 2px 3px 2px;}\r\n\r\n/*Specifieke wijzigingen om ervoor te zorgen dat pagina`s geen scrollbar krijgen*/\r\n\r\n/*ADA*/\r\n#bedrijfGegevensPage h1{\r\n\tmargin-top:0px;\r\n}\r\n\r\n#bedrijfGegevensPage fieldset{\r\n\tpadding: 10px 5px 10px 5px;\r\n}\r\n\r\n#bedrijfGegevensPage fieldset:first-of-type{\r\n\tpadding: 0px;\r\n}\r\n\r\n#bedrijfGegevensPage h1{\r\n\tmargin-top:0px;\r\n}\r\n\r\n#functieAnalysePage fieldset{\r\n\tpadding:10px 5px 10px 5px;\r\n}\r\n\r\n#arbeidResultaatEindselectiePage span, td{\r\n\tpadding:5px 0px 1px 4px;\r\n}\r\n\r\n.commandLinkResOverzicht {\r\n  padding:5px 0px 1px 4px;\r\n}\r\n\r\n#arbeidBeoordelingsgegevensPage fieldset {\r\n\tpadding:9px 5px 9px 5px;\r\n}\r\n\r\n#formFunctieAddRedenVerwijder .formField label{\r\n\tfont-weight:bold;\r\n}\r\n\r\n#foutiefForm .formField label{\r\n\tfont-weight:bold;\r\n}\r\n\r\n#vraagAntwoord .formField label{\r\n\tfont-weight:bold;\r\n}\r\n\r\n/*eindbeoordelingspagina verwijderen van borderradius*/\r\ntable.dr-table.selectieproces.noborder thead tr th:last-child {\r\n\tborder-radius: 0px;\r\n}\r\n\r\ntable.winkelmandje thead tr th:first-child{\r\n\tborder-radius: 0px;\r\n}\r\n\r\n.winkelmandje tr th:last-child{\r\n\tborder-radius:0px;\r\n}\r\n\r\n/*eindbeoordelingspagina wijziggen positie checkbox*/\r\n.selectieproces input[type=\"checkbox\"] {\r\n    margin-top: 8px;\r\n}\r\n\r\n.bedrijfsgegevensform {\r\n\twidth:48%!important;\r\n}\r\n\r\n/*Stukje code voor het formaat van de body bij het gebruiken van een kleinere resolutie scherm\r\n@media screen and (max-width: 1368px) and (min-width: 1364px){\r\n\tbody{\r\n\t\twidth:105%;\r\n\t}\r\n}\r\n*/\r\n\r\n#functieZoekenPage\\:searchresult\\:j_id101 {\r\n\tdisplay:none;\r\n}\r\n\r\n#searchForm\\:Result\\:j_id129 {\r\n\tdisplay:none;\r\n}\r\n\r\n/*VA - Stukje code om de linkerrij (labels) op de klantgegevens pagina dikgedrukt te maken*/\r\n#klantGegevensPageForm\\:klantSoortFieldLabel,\r\n#klantGegevensPageForm\\:klantVoorlettersFieldLabel,\r\n#klantGegevensPageForm\\:klantVoorvoegselFieldLabel,\r\n#klantGegevensPageForm\\:klantAchternaamFieldLabel,\r\n#klantGegevensPageForm\\:klantTussenvoegselPartnerFieldLabel,\r\n#klantGegevensPageForm\\:klantAchternaamPartnerFieldLabel,\r\n#klantGegevensPageForm\\:klantNaamgebruikFieldLabel,\r\n#klantGegevensPageForm\\:klantGeboorteDatumFieldLabel,\r\n#klantGegevensPageForm\\:klantGeslachtFieldLabel,\r\n#beoordelingGegevensPage\\:klantProcessFieldLabel,\r\n#beoordelingGegevensPage\\:aanvangFieldLabel,\r\n#beoordelingGegevensPage\\:eindFieldLabel,\r\n#cascodesInLabel,\r\n#beoordelingGegevensPage\\:criteriumFieldLabel,\r\n#beoordelingGegevensPage\\:typeBeoordelingFieldLabel,\r\n#beoordelingGegevensPage\\:beoordelingConclusieFieldLabel,\r\n#beoordelingGegevensPage\\:beoordelingToelichtingFieldLabel,\r\n#beoordelingGegevensPage\\:duurzaamFieldLabel,\r\n#beoordelingGegevensPage\\:generalRemarkFieldLabel,\r\n#editProfielForm\\:naamFieldLabel, #editProfielForm\\:functie1FieldLabel,\r\n#functieZoekenPage\\:SbiKlassePanel label,\r\n#functieZoekenPage\\:NaamPanel label,\r\n#functieZoekenPage\\:SbcCodePanel label,\r\n#functieTakenPage\\:ErrorPanel label,\r\n#functieZoekenPage\\:AdaListPanel1 label,\r\n#functieZoekenPage\\:AdaListPanel2 label, .taak00a {\r\n\tfont-weight:600;\r\n\twidth:14em;\r\n}\r\n\r\n#functieAlgemeenPage label,\r\n#functieBekwaamhedenPage label,\r\n#functieInhoudPage label,\r\n#functieArbeidspatroonPage label,\r\n#functieLoonGegevensPage label,\r\n#functieAnalysePage label,\r\n#functieBelastingPage label,\r\n#arbeidAfdrukkenAfrondenPage\\:afrondvraagFieldLabel label,\r\n#borgingReportPage label,\r\n#informatieViewPage label {\r\n\tfont-weight:600;\r\n}\r\n\r\n#formSbcCodesZoek\\:codeFldFieldLabel, #formSbcCodesZoek\\:omschrijvingFldFieldLabel, #formSbiKlassenZoek\\:codeFldFieldLabel, #formSbiKlassenZoek\\:naamFldFieldLabel, #werksoortZoek\\:codeFieldLabel, #werksoortZoek\\:naamFieldLabel, #werksoortZoek\\:omsFldFieldLabel {\r\n\tWidth:8em; font-weight:600;\r\n}\r\n\r\n#arbeidBeoordelingsgegevensPage label{\r\n\tfont-weight:600;\r\n\twidth:19em;\r\n}\r\n\r\n#cas{\r\n\twidth:450px;\r\n}\r\n\r\n#cas_view {\r\n  width:450px;\r\n}\r\n\r\n@media screen and (-webkit-min-device-pixel-ratio:0) {\r\n \t#cas{\r\n\t\twidth: 450px;\r\n\t\tleft: 41.7%;\r\n\t\ttop: -18px;\r\n\t}\r\n}\r\n\r\n\r\n#klantDossierPage\\:subview3\\:filterDate {\r\n\tmargin-right:3px;\r\n}\r\n\r\n#klantDossierPage\\:subview3\\:filterButton {\r\n\ttop:-5px;\r\n\tmargin: 0 0 0 5px; padding: 6px 12px 6px 12px; background-color: #0078D2;  border-radius: 5px;color: #FFFFFF; direction:ltr;\r\n}\r\n\r\n#klantDossierPage\\:subview3\\:filterButton:hover {\r\n\tbackground-color: #0058a8; color:#FFFFFF; cursor:pointer;\r\n}\r\n\r\n/*Positie elk eerste kolom in tabel*/\r\n#aoklasseDataTable\\:tbody_element td:first-of-type, #verworpenDataTable\\:tbody_element td:first-of-type, #arbeidResultaatEindselectiePage\\:functieselectieList\\:tbody_element td:first-of-type{\r\n\tpadding-left:12px;\r\n}\r\n\r\n.resultaat td:first-of-type {\r\n\tpadding-right:25px;\r\n}\r\n\r\n#voorselectiePageReport .floatright a {\r\n\twidth:230px!important;\r\n}\r\n\r\n#voorselectiePageReport .floatright .icon.pdf {\r\n\tbackground-position: -2% -4px;\r\n}\r\n\r\n#editVoorkeur .floatright a {\r\n\twidth:100px!important;\r\n}\r\n\r\n#functieselectieForm\\:reportFML{\r\n\twidth:40px!important;\r\n}\r\n\r\n#functieselectieForm\\:reportKFML{\r\n\twidth:90px!important;\r\n}\r\n/*Positionering rapport \"bedrijfsbeschrijving\" PDF ophalen*/\r\n#bedrijfGegevensPage\\:printButton, #bedrijfFunctiePage\\:printButton, #bedrijfNotitiePage\\:printButton  {\r\n\tmin-width: 200px!important;\r\n    position: relative;\r\n    right: -10%;\r\n}\r\n\r\n/*Verwijderen van blauwe stippellijn bij details functiebelastingpagina*/\r\n#functieBelastingPage\\:belastingpuntDetailDiv .dr-table tbody tr td{\r\n\tbackground: none;\r\n}\r\n\r\n/*aanpassingen m.b.t. rubrieken en beoordelingspagina*/\r\n#report .parent td:first-child{\r\n\twidth:10px;\r\n}\r\n\r\n#report .parent td:first-child + td{\r\n\twidth:15px;\r\n}\r\n\r\n/*Aanpassingen beordelingsgegevenspagina*/\r\n#arbeidBeoordelingsgegevensPage\\:beoordelingsCriteriumFieldInput label{\r\n\tfont-weight:400!important;\r\n}\r\n\r\n#arbeidBeoordelingsgegevensPage\\:setSelectieFBVandaag:disabled, #arbeidBeoordelingsgegevensPage\\:setSelectieDatumFMLGeldigVanaf:disabled, #arbeidBeoordelingsgegevensPage\\:startVoorselectieButton:disabled, #arbeidBeoordelingsgegevensPage\\:viewKlantDossierButton1:disabled   {\r\n  color:#666;\r\n  background-color:#f0f0f0;\r\n  border-color: #555555;\r\n  pointer-events: none;\r\n}\r\n\r\n#arbeidBeoordelingsgegevensPage\\:setSelectieFBVandaag:disabled:hover,#arbeidBeoordelingsgegevensPage\\:setSelectieDatumFMLGeldigVanaf:disabled:hover, #arbeidBeoordelingsgegevensPage\\:startVoorselectieButton:disabled:hover, #arbeidBeoordelingsgegevensPage\\:viewKlantDossierButton1:disabled:hover  {\r\n  color:#666;\r\n  background-color:#f0f0f0;\r\n  border-color: #555555;\r\n  pointer-events: none;\r\n}\r\n\r\n/*knoppen voor selecteren SelectieDatum*/\r\n#wrapperDatumSelButtons{\r\n  margin-top:-3px;\r\n  float:left;\r\n}\r\n\r\n#arbeidBeoordelingsgegevensPage table.input.radiobuttons td,  #arbeidBeoordelingsgegevensPage table.input.checkboxes td{\r\n\twidth:auto!important;\r\n}\r\n\r\n/* Eindresultaat Overzicht kolom Status moet een vaste breedte hebben imv verspringen */\r\n.fixed-width-ResOverzicht{\r\n  width: 180px !important;\r\n  min-width: 180px;\r\n}\r\n\r\n.morethanparamdaysold {\r\n  color: #ff0000\r\n}\r\n\r\n"
