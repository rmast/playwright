            "text": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\" >\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n\n<head>\n\t<title>Claim Beoordelings- en Borgings Systeem (CBBS)</title>\n\t<link class=\"component\" href=\"/cbbs/a4j/s/3_3_3.Finalorg/richfaces/renderkit/html/css/basic_classes.xcss/DATB/eAE7ff3HutDlM6QBGgsE-A__.jsf\" rel=\"stylesheet\" type=\"text/css\" /><link class=\"component\" href=\"/cbbs/a4j/s/3_3_3.Finalorg/richfaces/renderkit/html/css/extended_classes.xcss/DATB/eAE7ff3HutDlM6QBGgsE-A__.jsf\" media=\"rich-extended-skinning\" rel=\"stylesheet\" type=\"text/css\" /><script src=\"/cbbs/a4j/g/3_3_3.Finalorg.ajax4jsf.javascript.AjaxScript.jsf\" type=\"text/javascript\"></script><script src=\"/cbbs/a4j/g/3_3_3.Finalorg/ajax4jsf/javascript/scripts/form.js.jsf\" type=\"text/javascript\"></script><script type=\"text/javascript\">window.RICH_FACES_EXTENDED_SKINNING_ON=true;</script><script src=\"/cbbs/a4j/g/3_3_3.Finalorg/richfaces/renderkit/html/scripts/skinning.js.jsf\" type=\"text/javascript\"></script><script src=\"/cbbs/a4j/g/3_3_3.Finaljquery.js.jsf\" type=\"text/javascript\"></script><link rel=\"icon\" href=\"/cbbs/resources/images/icons/uwv_icon.jpg\" type=\"image/jpg\" />\n\t<meta http-equiv=\"Content-Type\" content=\"text/html; charset=utf-8\" />\n\n\t<script language=\"javascript\"><!--\n\n\t\tvar connectionHandler;\n\t\n//--></script>\n\n<link href=\"/cbbs/resources/css/cbbs_basis.css\" rel=\"stylesheet\" media=\"screen\" type=\"text/css\" />\n\n<link href=\"/cbbs/resources/css/cbbs_richfaces_restyle.css\" rel=\"stylesheet\" media=\"screen\" type=\"text/css\" />\n\n<script type=\"text/javascript\" src=\"/cbbs/resources/scripts/count_ita.js\"><!--\n\n//--></script>\n\n<script type=\"text/javascript\" src=\"/cbbs/resources/scripts/hover.js\"><!--\n\n//--></script>\n\n<script type=\"text/javascript\" src=\"/cbbs/resources/scripts/lov.js\"><!--\n\n//--></script>\n\n<script type=\"text/javascript\" src=\"/cbbs/resources/scripts/accesskey.js\"><!--\n\n//--></script>\n\n<script type=\"text/javascript\"><!--\n\n\n\n\tjQuery(function(){\n\n\t\tjQuery('input').keydown(function(event){\n\t\t\t\n\t\t\tif (window.location.pathname !== '/cbbs/arbeid/editBeoordelingsgegevens.jsf') {\n\t\t\t\tif (event.keyCode == 13) {\n\t\t\t\t\tif (event.target.type == 'submit') {\n\t\t\t\t\t\t\n\t\t\t\t\t\tevent.target.click();\n\t\t\t\t\t} else {\n\t\t\t\t\t\t\n\t\t\t\t\t\tevent.target.blur();\n\t\t\t\t\t\t\n\t\t\t\t\t\tsetTimeout(\n\t\t\t\t\t\t\t\tfunction () {\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\tgetFirstVisibleEnabledSubmitButton().click();\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t, 50\n\t\t\t\t\t\t);\n\t\t\t\t\t}\n\t\t\t\t\treturn false;\n\t\t\t\t}\n\t\t\t}\n\t\t\t});\n\n\t\t\n\t\tgetFirstVisibleEnabledSubmitButton().focus();\n\t\tjQuery(\":input[type!=submit]:visible:enabled:first\").focus();\n\t});\n\n\tfunction getFirstVisibleEnabledSubmitButton(){\n\t\t\n\t\tvar button = jQuery(':(input[type=button],input[type=submit]):visible:enabled.defaultSubmitButton:first');\n\t\tif (button.size() == 0) {\n\t\t\t\n\t\t\tbutton = jQuery(':input[type=submit]:visible:enabled:first');\n\t\t}\n\t\treturn button;\n\t}\n\n\tfunction printObjectsSelected(output, sgcomponent){\n\t\tvar selectedValue = sgcomponent.getSelectedItems().pluck('omschrijving');\n\t\tif (output.type == 'text'){\n\t\t\toutput.value = selectedValue;\n\t\t} else {\n\t\t\toutput.innerHTML= selectedValue;\n\t\t}\n\t};\n\n\tfunction printObjectsSelectedAndSubmit(form, output, sgcomponent){\n\t\tprintObjectsSelected(output, sgcomponent);\n\t\tform.submit();\n\t};\n\n\tfunction setTabIndex(id, index){\n\t\tvar selector = '#' + id.replace(':','\\\\\\:');\n\t\tjQuery(selector).val(index);\n\t\tjQuery(\".tabSubmitButton\").click();\n\t};\n\n\n//--></script>\n\t<script language=\"javascript\"><!--\n\n        function Reopen() {\n        \tif (window.name != '